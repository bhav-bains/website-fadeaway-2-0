---
// Portfolio (/portfolio/, Resources dropdown). Content: src/data/pages/portfolio.ts (from copy/portfolio.md).
// Every card comes from the central work collection (src/content/portfolio.yaml) through getWork(), in page order:
// case studies, featured, labs, list. A section or list group with no visible entries renders nothing, and the
// jump links and ItemList only include what renders. No portfolio detail pages: cards link to a case study or the live site.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPreview from '../components/blocks/hero/HeroPreview.astro';
import Section from '../components/blocks/Section.astro';
import ProofGrid from '../components/blocks/ProofGrid.astro';
import WorkCard from '../components/blocks/WorkCard.astro';
import WorkCompactCard from '../components/blocks/WorkCompactCard.astro';
import Faq from '../components/blocks/Faq.astro';
import AuditCta from '../components/blocks/AuditCta.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '../lib/schema';
import { getWork, workHref, type Work } from '../lib/work';
import { routes } from '../data/routes';
import { auditCta } from '../data/pages/audit';
import {
  seo,
  breadcrumb,
  hero,
  heroVariant,
  answerCapsule,
  jumpNav,
  caseStudies,
  cardLabels,
  featured,
  labs,
  moreWork,
  faq,
  cta,
} from '../data/pages/portfolio';

const work = await getWork();
const byKind = (kind: Work['data']['kind']) => work.filter((w) => w.data.kind === kind);
const studies = byKind('case-study');
const featuredWork = byKind('featured');
const labsWork = byKind('labs');
const groups = moreWork.groups
  .map((g) => ({ ...g, entries: byKind('list').filter((w) => w.data.group === g.group) }))
  .filter((g) => g.entries.length > 0);

const visibleIds = new Set(work.map((w) => w.id));
const ecommerceNote = moreWork.ecommerceNote.filter((n) => visibleIds.has(n.work));
const rendered = new Set([
  ...(studies.length ? [caseStudies.id] : []),
  ...(featuredWork.length ? [featured.id] : []),
  ...(labsWork.length ? [labs.id] : []),
  ...groups.map((g) => g.group),
]);
const jumpLinks = jumpNav.links.filter((l) => rendered.has(l.id));
const compactHint = `${cardLabels.visitSite.toLowerCase()}, ${cardLabels.newTab}`;

// ItemList: every visible entry in page order (case studies → detail page; everything else → live site)
const listed = [...studies, ...featuredWork, ...labsWork, ...groups.flatMap((g) => g.entries)];
const jsonLd = [
  collectionPageSchema({
    url: routes.portfolio,
    name: seo.title,
    description: seo.description,
    items: listed
      .map((w) => ({ name: w.data.name, url: workHref(w) }))
      .filter((i): i is { name: string; url: string } => !!i.url),
  }),
  breadcrumbSchema(breadcrumb),
  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /portfolio/?hero=statement | showcase | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['statement', 'showcase', 'visual']} />

  <!-- Answer capsule directly under the Hero, then the jump links -->
  <div class="bg-canvas px-2 pb-6 sm:px-3 md:pb-8 lg:px-4">
    <div class="mx-auto flex max-w-site flex-col gap-4 border-t border-line pt-4 md:pt-6">
      <p class="w-full text-pretty text-base text-ink-soft md:text-lg lg:w-3/4">{answerCapsule}</p>
      {
        jumpLinks.length > 0 && (
          <nav aria-label={jumpNav.label}>
            <ul class="flex flex-wrap gap-1">
              {jumpLinks.map((l) => (
                <li>
                  <a
                    href={`#${l.id}`}
                    class="inline-flex min-h-[2.75rem] items-center rounded-pill border border-line-strong px-2 text-meta font-semibold text-ink-soft transition-colors hover:border-highlight/40 hover:text-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight/50"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>

  {
    studies.length > 0 && (
      <Section
        id={caseStudies.id}
        eyebrow={caseStudies.eyebrow}
        heading={caseStudies.heading}
        intro={caseStudies.intro}
        tone="alt"
        align="start"
        class="scroll-mt-24"
      >
        <ArrowLink slot="actions" href={caseStudies.link.href}>
          {caseStudies.link.label}
        </ArrowLink>
        <ProofGrid entries={studies.map((w) => w.study!)} />
      </Section>
    )
  }

  {
    featuredWork.length > 0 && (
      <Section
        id={featured.id}
        eyebrow={featured.eyebrow}
        heading={featured.heading}
        intro={featured.intro}
        align="start"
        class="scroll-mt-24"
      >
        <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-4 lg:gap-4">
          {featuredWork.map((w) => (
            <li>
              <WorkCard entry={w} labels={cardLabels} variant="featured" />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    labsWork.length > 0 && (
      <Section
        id={labs.id}
        eyebrow={labs.eyebrow}
        heading={labs.heading}
        intro={labs.intro}
        tone="alt"
        align="start"
        class="scroll-mt-24"
      >
        <ArrowLink slot="actions" href={labs.link.href}>
          {labs.link.label}
        </ArrowLink>
        <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
          {labsWork.map((w) => (
            <li>
              <WorkCard entry={w} labels={cardLabels} variant="labs" />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    groups.length > 0 && (
      <Section id={moreWork.id} heading={moreWork.heading} align="start">
        <div class="flex flex-col gap-6 md:gap-8">
          {groups.map((g) => (
            <section id={g.group} aria-labelledby={`${g.group}-heading`} class="scroll-mt-24">
              <h3
                id={`${g.group}-heading`}
                class="border-b border-line pb-1 font-display text-xl font-bold text-ink md:text-2xl"
              >
                {g.heading}
              </h3>
              {g.group === 'ecommerce' && ecommerceNote.length > 0 && (
                <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-meta text-ink-muted">
                  {ecommerceNote.map((n) => (
                    <span>
                      {n.prefix}{' '}
                      <a
                        href={n.href}
                        class="font-semibold text-highlight underline decoration-highlight/30 underline-offset-4 hover:decoration-highlight"
                      >
                        {n.label}
                      </a>
                      .
                    </span>
                  ))}
                </p>
              )}
              <ul class="mt-3 grid gap-2 md:grid-cols-2 lg:grid-cols-3">
                {g.entries.map((w) => (
                  <li>
                    <WorkCompactCard entry={w} linkHint={compactHint} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </Section>
    )
  }

  <Section id={faq.id} heading={faq.heading} tone="alt" width="narrow">
    <Faq faq={faq.items} />
  </Section>

  <Section id="cta" labelledBy="cta-heading">
    <AuditCta
      heading={cta.heading}
      text={cta.text}
      fieldLabel={auditCta.fieldLabel}
      placeholder={auditCta.placeholder}
      button={cta.button}
      action={auditCta.action}
      headingAs="h2"
      headingId="cta-heading"
    />
  </Section>
</BaseLayout>
