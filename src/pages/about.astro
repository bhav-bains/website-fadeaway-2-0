---
// About page: the entity page. Content: src/data/pages/about.ts (from copy/about.md).
// Schema here: AboutPage (mainEntity → Organization), the founder's Person, BreadcrumbList, FAQPage. The sitewide
// Organization node already names the founder. "At a Glance" is the main AEO asset (one plain-text fact per line).
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPreview from '../components/blocks/hero/HeroPreview.astro';
import Section from '../components/blocks/Section.astro';
import FactList from '../components/blocks/FactList.astro';
import SpecGrid from '../components/blocks/SpecGrid.astro';
import FounderCard from '../components/blocks/FounderCard.astro';
import IconGrid from '../components/blocks/IconGrid.astro';
import LinkCards from '../components/blocks/LinkCards.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import WorkGrid from '../components/blocks/WorkGrid.astro';
import Faq from '../components/blocks/Faq.astro';
import CtaBlock from '../components/blocks/CtaBlock.astro';
import IllusCourt from '../components/illustrations/IllusCourt.astro';
import { breadcrumbSchema, faqSchema, aboutPageSchema, founderSchema } from '../lib/schema';
import { getRealWork } from '../lib/work';
import { routes } from '../data/routes';
import {
  seo,
  breadcrumb,
  hero,
  heroVariant,
  answerCapsule,
  glance,
  whyFadeaway,
  beliefs,
  founder,
  howWeWork,
  whoWeWorkWith,
  realWork,
  faq,
  cta,
} from '../data/pages/about';

const work = await getRealWork(realWork.tag, realWork.limit);

const hasWork = work.length > 0;

const jsonLd = [
  aboutPageSchema({ url: routes.about, name: seo.title, description: seo.description }),
  founderSchema(founder.show ? { description: founder.bio } : {}),
  breadcrumbSchema(breadcrumb),
  faqSchema(faq.items),
];

---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /about/?hero=statement | showcase | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['statement', 'showcase', 'visual']} />

  <!-- Answer capsule (AEO summary) is the wide intro; the fact sheet follows -->
  <Section id={glance.id} heading={glance.heading} intro={answerCapsule} introStyle="wide" align="start">
    <FactList items={glance.items} />
  </Section>

  <!-- The name story as two layers: the shot (oversized statement) over the work it stands for (quieter note beside
       it), with the fadeaway line art bleeding off the right edge on every screen size -->
  <Section id={whyFadeaway.id} heading={whyFadeaway.heading} align="start" class="overflow-hidden">
    <IllusCourt
      class="pointer-events-none absolute -right-24 bottom-0 -z-10 w-[34rem] max-w-none text-accent opacity-25 [mask-image:linear-gradient(to_left,#000_35%,transparent_95%)] sm:-right-16 lg:top-1/2 lg:right-0 lg:bottom-auto lg:w-[46rem] lg:-translate-y-1/2 lg:opacity-30"
    />
    <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-6">
      <p class="text-balance font-display text-xl font-semibold leading-snug text-ink sm:text-2xl lg:col-span-8 lg:text-3xl xl:text-4xl xl:leading-tight">
        {whyFadeaway.paragraphs[0]}
      </p>
      <div class="border-l-2 border-accent pl-3 lg:col-span-4 lg:pb-1">
        {whyFadeaway.paragraphs.slice(1).map((p) => <p class="text-pretty text-lg leading-relaxed text-ink-soft">{p}</p>)}
      </div>
    </div>
    <!-- Founder's own version of the name story (open item in copy/about.md) renders here once supplied -->
  </Section>

  <Section id={beliefs.id} heading={beliefs.heading} align="start" class="overflow-x-clip">
    <SpecGrid items={beliefs.items} columns={3} />
  </Section>

  {
    founder.show && (
      <Section id={founder.id} heading={founder.heading} align="start">
        <FounderCard name={founder.name} title={founder.title} bio={founder.bio} />
      </Section>
    )
  }

  <!-- Target of the Hero's "See How We Work" -->
  <Section id={howWeWork.id} heading={howWeWork.heading} align="start">
    <IconGrid items={howWeWork.items} columns={3} size="md" />
  </Section>

  <Section id={whoWeWorkWith.id} heading={whoWeWorkWith.heading} align="start">
    <LinkCards items={whoWeWorkWith.items} />
  </Section>

  {
    hasWork && (
      <Section id={realWork.id} heading={realWork.heading} intro={realWork.intro} align="start">
        <ArrowLink slot="actions" href={realWork.link.href}>
          {realWork.link.label}
        </ArrowLink>
        <WorkGrid entries={work} />
      </Section>
    )
  }

  <Section id={faq.id} heading={faq.heading} width="narrow">
    <Faq faq={faq.items} />
  </Section>

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow">
    <CtaBlock
      heading={cta.heading}
      text={cta.text}
      cta={cta.cta}
      link={cta.link}
      headingAs="h2"
      headingId={`${cta.id}-heading`}
      layout="center"
    />
  </Section>
</BaseLayout>
