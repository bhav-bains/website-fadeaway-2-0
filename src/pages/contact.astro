---
// Contact. Content: src/data/pages/contact.ts (from copy/contact.md).
// Netlify form name `website-contact-form` is unchanged from the old page, so existing notifications keep working.
// Hero: FormHero (text + other ways to connect left, form right). Contact details come from src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import FormHero from '../components/blocks/FormHero.astro';
import ContactOptions from '../components/blocks/ContactOptions.astro';
import { breadcrumbSchema, contactPageSchema } from '../lib/schema';
import { routes } from '../data/routes';
import { seo, breadcrumb, hero, form, connect } from '../data/pages/contact';

const jsonLd = [contactPageSchema({ url: routes.contact, name: seo.title, description: seo.description }), breadcrumbSchema(breadcrumb)];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <FormHero
    breadcrumb={breadcrumb}
    eyebrow={hero.eyebrow}
    displayLine={hero.displayLine}
    h1={hero.h1}
    sub={hero.sub}
    form={form}
    halfWidth={['name', 'email', 'business', 'website']}
  >
    <div class="mt-6 flex w-full flex-col gap-3 border-t border-line pt-4 md:mt-8 md:pt-6">
      <ContactOptions items={connect.items} newTabLabel={connect.newTabLabel} />
      <p class="text-pretty text-meta text-ink-muted">{hero.location}</p>
    </div>
  </FormHero>
</BaseLayout>
