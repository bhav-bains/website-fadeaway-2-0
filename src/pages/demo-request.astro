---
// Free website demo request (fitness, wellness, sports). Content: src/data/pages/demo.ts (from copy/demo-request.md).
// Rebuilt from scratch; the Dec 2025 version stays parked in src/pages/_inactive for reference.
// Hero: text left, form right on lg (form directly below the text on phones). No CTA buttons in the Hero.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/blocks/Breadcrumb.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import Field from '../components/blocks/form/Field.astro';
import Section from '../components/blocks/Section.astro';
import Steps from '../components/blocks/Steps.astro';
import CardGrid from '../components/blocks/CardGrid.astro';
import Faq from '../components/blocks/Faq.astro';
import CtaBlock from '../components/blocks/CtaBlock.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import LineRings from '../components/ui/LineRings.astro';
import { breadcrumbSchema, howToSchema, faqSchema } from '../lib/schema';
import { siteConfig } from '../data/site';
import { routes } from '../data/routes';
import { seo, breadcrumb, answerCapsule, hero, form, howItWorks, industries, faq, cta } from '../data/pages/demo';

const jsonLd = [
  breadcrumbSchema(breadcrumb),
  howToSchema({
    name: howItWorks.heading,
    steps: howItWorks.items,
    url: new URL(`${routes.demoRequest}#${howItWorks.id}`, siteConfig.url).toString(),
  }),
  faqSchema(faq.items),
];

// Short fields pair up from sm; the url and textarea run full width
const halfWidth = new Set(['name', 'email', 'business', 'industry']);
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <section
    id="hero"
    aria-labelledby="hero-title"
    class="relative isolate overflow-hidden border-b border-line px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pb-16 lg:pt-40"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_60%_60%_at_20%_30%,#000_30%,transparent_100%)]"></div>
      <LineRings
        class="absolute -left-64 top-40 w-[48rem] max-w-none text-highlight opacity-20 [mask-image:radial-gradient(circle_at_60%_40%,#000_30%,transparent_70%)]"
      />
    </div>

    <div class="mx-auto grid w-full max-w-site gap-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-start lg:gap-12">
      <div class="flex flex-col items-start lg:sticky lg:top-40">
        <Breadcrumb items={breadcrumb} class="mb-3" />
        <Eyebrow tone="accent">{hero.eyebrow}</Eyebrow>
        <h1
          id="hero-title"
          class="mt-3 max-w-2xl text-balance font-display text-[clamp(2.5rem,1.5rem+4vw,4.5rem)] font-bold leading-[1.02] tracking-tight text-ink"
        >
          {hero.h1}
        </h1>
        <p class="mt-4 max-w-xl text-pretty text-lead text-ink-soft md:mt-5">{hero.sub}</p>
      </div>

      <!-- Demo request form (Netlify Forms) -->
      <div id="form" class="scroll-mt-28 rounded-card bg-gradient-to-br from-accent/50 via-line to-highlight/40 p-px">
        <form
          name={form.name}
          method="POST"
          action={form.action}
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="grid gap-3 rounded-[calc(var(--radius-card)-1px)] bg-surface-raised p-3 sm:grid-cols-2 md:p-5"
        >
          <input type="hidden" name="form-name" value={form.name} />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          {form.fields.map((field) => <Field {...field} class={halfWidth.has(field.name) ? '' : 'sm:col-span-2'} />)}

          <div class="flex flex-col gap-2 sm:col-span-2">
            <Button type="submit" variant="primary" size="base" fullWidth>{form.submit}</Button>
            <p class="text-center text-meta text-ink-muted">{form.note}</p>
          </div>

          <p class="flex flex-wrap items-center justify-center gap-x-1 border-t border-line pt-3 text-meta text-ink-soft sm:col-span-2">
            {form.ecommerce.text}
            <ArrowLink href={form.ecommerce.link.href}>{form.ecommerce.link.label}</ArrowLink>
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Answer capsule (AEO summary) is the lead paragraph of the first section after the Hero -->
  <Section id={howItWorks.id} lead={answerCapsule} heading={howItWorks.heading} tone="alt">
    <Steps items={howItWorks.items} />
  </Section>

  <Section id={industries.id} heading={industries.heading}>
    <CardGrid items={industries.items} columns={3} />
  </Section>

  <Section id={faq.id} heading={faq.heading} width="narrow" tone="alt">
    <Faq faq={faq.items} />
  </Section>

  <Section id={cta.id} labelledBy={`${cta.id}-heading`}>
    <CtaBlock heading={cta.heading} text={cta.text} cta={cta.cta} headingAs="h2" headingId={`${cta.id}-heading`} />
  </Section>
</BaseLayout>
