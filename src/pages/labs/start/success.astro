---
// Labs intake thank-you page (form action target). noindex, kept out of the sitemap (astro.config.mjs).
// Content: `success` in src/data/pages/labs-start.ts (from copy/labs-start.md).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/Button.astro';
import LinkIndex from '../../../components/blocks/LinkIndex.astro';
import LineRings from '../../../components/ui/LineRings.astro';
import { success } from '../../../data/pages/labs-start';
---

<BaseLayout title={success.seo.title} description={success.seo.description} noIndex>
  <section
    aria-labelledby="success-title"
    class="relative isolate flex min-h-svh flex-col overflow-hidden px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pb-16 lg:pt-40"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,#000_40%,transparent_100%)]"></div>
      <LineRings
        class="absolute -right-56 -top-40 w-[52rem] max-w-none text-highlight opacity-20 [mask-image:radial-gradient(circle_at_35%_55%,#000_30%,transparent_70%)] md:-right-40"
      />
    </div>

    <div class="mx-auto grid w-full max-w-site flex-1 content-center gap-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-center lg:gap-12">
      <div class="flex flex-col items-start">
        <!-- Line-art check: a request received and on its way -->
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 96 96"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-[5.5rem] text-highlight md:size-[7rem]"
        >
          <circle cx="48" cy="48" r="30" vector-effect="non-scaling-stroke" />
          <circle cx="48" cy="48" r="42" opacity=".35" stroke-dasharray="2 5" vector-effect="non-scaling-stroke" />
          <path class="draw-check" d="M35 49l9 9 18-20" stroke-width="2.5" vector-effect="non-scaling-stroke" />
        </svg>
        <h1
          id="success-title"
          class="mt-4 max-w-2xl text-balance font-display text-[clamp(2.5rem,1.5rem+4vw,4.5rem)] font-bold leading-[1.02] tracking-tight text-ink"
        >
          {success.h1}
        </h1>
        <p class="mt-4 max-w-xl text-pretty text-lead text-ink-soft">{success.text}</p>
        <Button href={success.button.href} variant="secondary" size="base" className="mt-5">{success.button.label}</Button>
      </div>

      <LinkIndex heading={success.linksHeading} id="success-links" links={success.links} />
    </div>
  </section>
</BaseLayout>

<style>
  /* The check draws itself once on load; static for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .draw-check {
      stroke-dasharray: 60;
      stroke-dashoffset: 60;
      animation: draw 0.7s 0.2s ease-out forwards;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
