---
// E-commerce Solutions page. Content: src/data/pages/ecommerce.ts (from copy/ecommerce.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPreview from '../../components/blocks/hero/HeroPreview.astro';
import Section from '../../components/blocks/Section.astro';
import AnnotatedVisual from '../../components/blocks/AnnotatedVisual.astro';
import BentoGrid from '../../components/blocks/BentoGrid.astro';
import ServiceIndex from '../../components/blocks/ServiceIndex.astro';
import Steps from '../../components/blocks/Steps.astro';
import WorkGrid from '../../components/blocks/WorkGrid.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/blocks/Faq.astro';
import CtaBlock from '../../components/blocks/CtaBlock.astro';
import IllusAsk from '../../components/illustrations/IllusAsk.astro';
import IllusCycle from '../../components/illustrations/IllusCycle.astro';
import { breadcrumbSchema, howToSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { getRealWork } from '../../lib/work';
import { siteConfig } from '../../data/site';
import { routes } from '../../data/routes';
import { seo, breadcrumb, hero, heroVariant, answerCapsule, aiShopping, standard, services, howItWorks, realWork, faq, serviceNames, cta } from '../../data/pages/ecommerce';

const work = await getRealWork(realWork.tag, realWork.limit);

const jsonLd = [
  breadcrumbSchema(breadcrumb),
  ...serviceSchema({ names: serviceNames, url: routes.ecommerce }),
  howToSchema({
    name: howItWorks.heading,
    steps: howItWorks.items,
    url: new URL(`${routes.ecommerce}#${howItWorks.id}`, siteConfig.url).toString(),
  }),  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /solutions/ecommerce?hero=showcase | statement | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['showcase', 'statement', 'visual']} />

  <!-- Answer capsule (AEO summary) is the lead paragraph of the first section after the Hero -->
  <Section id={aiShopping.id} lead={answerCapsule} heading={aiShopping.heading} intro={aiShopping.intro}>
    <AnnotatedVisual visual="ai-shopping" items={aiShopping.items} />
  </Section>

  <Section id={standard.id} heading={standard.heading} intro={standard.intro} align="start">
    <BentoGrid items={standard.items} cta={standard.cta} />
  </Section>

  <Section id={services.id} heading={services.heading} align="start" class="overflow-x-clip">
    <ServiceIndex items={services.items} cta={services.cta} />
  </Section>

  <!-- Target of the Hero's "See How It Works" button -->
  <Section id={howItWorks.id} heading={howItWorks.heading} layout="split">
    {/* Oversized loop line art under the pinned heading: step 4 feeds back into step 1 */}
    <IllusCycle
      slot="actions"
      class="pointer-events-none -ml-6 mt-4 hidden w-[26rem] max-w-none text-accent opacity-30 [mask-image:radial-gradient(circle,#000_45%,transparent_80%)] lg:block"
    />
    <Steps items={howItWorks.items} direction="vertical" />
  </Section>

  {
    work.length > 0 && (
      <Section id={realWork.id} heading={realWork.heading} intro={realWork.intro} align="start">
        <WorkGrid entries={work} />
        <div class="mt-4 flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-center sm:justify-between md:mt-6">
          <p class="font-display text-xl font-bold text-ink md:text-2xl">{realWork.ctaText}</p>
          <div class="flex flex-wrap gap-2">
            <Button href={realWork.primaryCta.href} variant="primary" size="base">
              {realWork.primaryCta.label}
            </Button>
            <Button href={realWork.secondaryCta.href} variant="secondary" size="base">
              {realWork.secondaryCta.label}
            </Button>
          </div>
        </div>
      </Section>
    )
  }

  <!-- Testimonials (tag ecommerce): renders nothing until real, permission-confirmed quotes exist -->

  <Section id={faq.id} heading={faq.heading} layout="split">
    {/* Oversized question-and-answer line art under the pinned heading */}
    <IllusAsk
      slot="actions"
      class="pointer-events-none -ml-4 mt-4 hidden w-[24rem] max-w-none text-accent opacity-30 [mask-image:radial-gradient(circle_at_40%_40%,#000_40%,transparent_80%)] lg:block"
    />
    <Faq faq={faq.items} />
  </Section>

  <!-- From the Blog (tag ecommerce, data: `blog` in ecommerce.ts): renders nothing until /articles/ has real e-commerce posts -->

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow">
    <CtaBlock heading={cta.heading} text={cta.text} cta={cta.cta} headingAs="h2" headingId={`${cta.id}-heading`} layout="center" />
  </Section>
</BaseLayout>
