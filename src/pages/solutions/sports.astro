---
// Sports Academies Solutions page: a conversion funnel on the same blocks as Wellness and Boutique Fitness.
// Content: src/data/pages/sports.ts (from copy/sports.md). Order: hook → what parents see → programs → what we do
// → method → free demo → pricing → what to expect → how it works → proof → why Fadeaway → FAQ → final ask.
// Outbound-first (founder outreach), so the Hero opens with a founder proof line and names the buyer.
// The old /sports/ page stays live until launch (301 to here then).
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPreview from '../../components/blocks/hero/HeroPreview.astro';
import Section from '../../components/blocks/Section.astro';
import BentoGrid from '../../components/blocks/BentoGrid.astro';
import ServiceIndex from '../../components/blocks/ServiceIndex.astro';
import IconGrid from '../../components/blocks/IconGrid.astro';
import ForkCallout from '../../components/blocks/ForkCallout.astro';
import FeatureList from '../../components/blocks/FeatureList.astro';
import DemoOffer from '../../components/blocks/DemoOffer.astro';
import PricingSection from '../../components/blocks/PricingSection.astro';
import Timeline from '../../components/blocks/Timeline.astro';
import Steps from '../../components/blocks/Steps.astro';
import WorkGrid from '../../components/blocks/WorkGrid.astro';
import Faq from '../../components/blocks/Faq.astro';
import CtaBlock from '../../components/blocks/CtaBlock.astro';
import IllusRadius from '../../components/illustrations/IllusRadius.astro';
import { breadcrumbSchema, howToSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { getRealWork } from '../../lib/work';
import { siteConfig } from '../../data/site';
import { routes } from '../../data/routes';
import {
  seo,
  breadcrumb,
  hero,
  heroVariant,
  answerCapsule,
  problem,
  programs,
  services,
  method,
  demo,
  pricing,
  expect,
  howItWorks,
  realWork,
  why,
  faq,
  serviceNames,
  serviceOffers,
  cta,
} from '../../data/pages/sports';

const work = await getRealWork(realWork.tag, realWork.limit);

const hasWork = work.length > 0;

const jsonLd = [
  breadcrumbSchema(breadcrumb),
  ...serviceSchema({ names: serviceNames, url: routes.sports, offers: serviceOffers }),
  howToSchema({
    name: howItWorks.heading,
    steps: howItWorks.items,
    url: new URL(`${routes.sports}#${howItWorks.id}`, siteConfig.url).toString(),
  }),
  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /solutions/sports/?hero=statement | showcase | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['statement', 'showcase', 'visual']} />

  <!-- Target of the Hero's "See What Parents Search For". The answer capsule is the wide intro; the section's own line sits above the bento -->
  <Section id={problem.id} heading={problem.heading} intro={answerCapsule} introStyle="wide" align="start">
    <p class="mb-3 max-w-2xl text-pretty text-base font-medium text-ink md:mb-4 md:text-lg">{problem.intro}</p>
    <BentoGrid items={problem.items} cta={problem.cta} />
  </Section>

  <Section id={programs.id} heading={programs.heading} align="start">
    <ServiceIndex items={programs.items} art="none" />
  </Section>

  <Section id={services.id} heading={services.heading} align="start">
    <IconGrid items={services.items} columns={3} size="md" />
    <ForkCallout heading={services.labs.heading} text={services.labs.text} link={services.labs.link} class="mt-6 md:mt-8" />
  </Section>

  <Section id={method.id} heading={method.heading} intro={method.intro} layout="split">
    {/* Oversized line art under the pinned heading: the club at the centre of the towns families drive from */}
    <IllusRadius
      slot="actions"
      class="pointer-events-none -ml-6 mt-4 hidden w-[24rem] max-w-none text-highlight opacity-30 [mask-image:radial-gradient(circle,#000_45%,transparent_80%)] lg:block"
    />
    <FeatureList items={method.items} columns={1} />
  </Section>

  <Section id={pricing.id} heading={pricing.heading} intro={pricing.intro} align="start">
    <PricingSection {...pricing} />
  </Section>

  <!-- Primary conversion: the free demo -->
  <Section id={demo.id} labelledBy={`${demo.id}-heading`}>
    <DemoOffer
      heading={demo.heading}
      headingId={`${demo.id}-heading`}
      text={demo.text}
      steps={demo.steps}
      cta={demo.cta}
      fallback={demo.fallback}
    />
  </Section>

  <Section id={expect.id} heading={expect.heading} intro={expect.intro} align="start">
    <Timeline items={expect.items} />
  </Section>

  <Section id={howItWorks.id} heading={howItWorks.heading}>
    <Steps items={howItWorks.items} />
  </Section>

  {
    hasWork && (
      <Section id={realWork.id} eyebrow={realWork.eyebrow} heading={realWork.heading} align="start">
        <WorkGrid entries={work} />
      </Section>
    )
  }

  <!-- Founder-led note: one large paragraph with an accent rule -->
  <Section id={why.id} heading={why.heading} width="narrow" align="start">
    <p class="border-l-2 border-accent/70 pl-3 text-pretty font-display text-xl font-medium leading-relaxed text-ink-soft md:pl-4 md:text-2xl">
      {why.text}
    </p>
  </Section>

  <!-- Testimonials (tag sports-academies): renders nothing until real, permission-confirmed quotes exist -->

  <Section id={faq.id} heading={faq.heading} width="narrow">
    <Faq faq={faq.items} />
  </Section>

  <!-- From the Blog (tag sports-academies, data: `blog` in sports.ts): renders nothing until /articles/ has real posts -->

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow">
    <CtaBlock
      heading={cta.heading}
      text={cta.text}
      cta={cta.cta}
      link={cta.link}
      headingAs="h2"
      headingId={`${cta.id}-heading`}
      layout="center"
    />
  </Section>
</BaseLayout>
