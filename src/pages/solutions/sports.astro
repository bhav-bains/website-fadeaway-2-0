---
// Sports Academies Solutions page: a conversion funnel on the same blocks as Boutique Fitness.
// Content: src/data/pages/sports.ts (from copy/sports.md, Oct 14 rewrite). Order: hook → what parents see → tailored
// solutions → from search to signed up → pricing → why Fadeaway → what to expect → proof → FAQ → final ask.
// No demo section and no /demo-request/ links (founder, Oct 14); How It Works and its HowTo schema are hidden.
// Outbound-first (founder outreach), so the Hero opens with a founder proof line and names the buyer.
// The old /sports/ page stays live until launch (301 to here then).
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPreview from '../../components/blocks/hero/HeroPreview.astro';
import Section from '../../components/blocks/Section.astro';
import BentoGrid from '../../components/blocks/BentoGrid.astro';
import CalloutCard from '../../components/blocks/CalloutCard.astro';
import CardGrid from '../../components/blocks/CardGrid.astro';
import CalloutRow from '../../components/blocks/CalloutRow.astro';
import IconGrid from '../../components/blocks/IconGrid.astro';
import StageList from '../../components/blocks/StageList.astro';
import PricingSection from '../../components/blocks/PricingSection.astro';
import Timeline from '../../components/blocks/Timeline.astro';
import Steps from '../../components/blocks/Steps.astro';
import WorkGrid from '../../components/blocks/WorkGrid.astro';
import Faq from '../../components/blocks/Faq.astro';
import CtaBlock from '../../components/blocks/CtaBlock.astro';
import { breadcrumbSchema, howToSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { getRealWork } from '../../lib/work';
import { siteConfig } from '../../data/site';
import { routes } from '../../data/routes';
import {
  seo,
  breadcrumb,
  hero,
  heroVariant,
  answerCapsule,
  problem,
  programs,
  services,
  pricing,
  customRow,
  why,
  expect,
  howItWorks,
  realWork,
  faq,
  serviceNames,
  serviceOffers,
  cta,
} from '../../data/pages/sports';

const work = await getRealWork(realWork.tag, realWork.limit);

const hasWork = work.length > 0;

const jsonLd = [
  breadcrumbSchema(breadcrumb),
  ...serviceSchema({ names: serviceNames, url: routes.sports, offers: serviceOffers }),
  // HowTo schema hidden with the How It Works section (founder Oct 14); restore both together:
  // howToSchema({ name: howItWorks.heading, steps: howItWorks.items, url: new URL(`${routes.sports}#${howItWorks.id}`, siteConfig.url).toString() }),
  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /solutions/sports/?hero=statement | showcase | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['statement', 'showcase', 'visual']} />

  <!-- First section after the Hero. The answer capsule is hidden visually but stays in the HTML as screen-reader text for AEO -->
  <Section id={problem.id} heading={problem.heading} align="start">
    <p class="sr-only">{answerCapsule}</p>
    <BentoGrid items={problem.items} cta={problem.cta} />
  </Section>

  <Section id={programs.id} heading={programs.heading} align="start">
    <CardGrid items={programs.items} cta={programs.cta} swipe compact phoneGrid ctaOnPhones={false} />
    <h3 class="mb-2 mt-6 text-meta font-semibold uppercase tracking-wider text-ink-muted md:mt-8">{programs.strip.label}</h3>
    <IconGrid items={programs.strip.items} columns={4} size="md" swipe collapse={false} idPrefix="program-strip" />
  </Section>

  <Section id={services.id} heading={services.heading} align="start">
    <StageList stages={services.stages} />
    {/* Phones only: the contact call-out sits under this section (on larger screens it is the last tile above). Each copy is display:none at the other breakpoint, so it is not read twice */}
    <CalloutCard {...programs.cta} class="mt-3 md:hidden" />
  </Section>

  <Section id={pricing.id} eyebrow={pricing.eyebrow} heading={pricing.heading} intro={pricing.intro}>
    <PricingSection {...pricing} />
    <CalloutRow {...customRow} class="mt-3 md:mt-4" />
  </Section>

  <!-- Founder-led note: one large paragraph with an accent rule -->
  <Section id={why.id} heading={why.heading} width="narrow" align="start">
    <p class="border-l-2 border-accent/70 pl-3 text-pretty font-display text-xl font-medium leading-relaxed text-ink-soft md:pl-4 md:text-2xl">
      {why.text}
    </p>
  </Section>

  <Section id={expect.id} heading={expect.heading} intro={expect.intro} align="start">
    <Timeline items={expect.items} />
  </Section>

  {/* HIDDEN Oct 14 (founder): How It Works (and its HowTo schema above). Data stays in sports.ts (howItWorks). To restore, put the Section back:
  <Section id={howItWorks.id} heading={howItWorks.heading}>
    <Steps items={howItWorks.items} />
  </Section>
  */}

  {
    hasWork && (
      <Section id={realWork.id} eyebrow={realWork.eyebrow} heading={realWork.heading} align="start">
        <WorkGrid entries={work} />
      </Section>
    )
  }

  <!-- Testimonials (tag sports-academies): renders nothing until real, permission-confirmed quotes exist -->

  <Section id={faq.id} heading={faq.heading} width="narrow">
    <Faq faq={faq.items} />
  </Section>

  <!-- From the Blog (tag sports-academies, data: `blog` in sports.ts): renders nothing until /articles/ has real posts -->

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow">
    <CtaBlock
      heading={cta.heading}
      text={cta.text}
      cta={cta.cta}
      link={cta.link}
      headingAs="h2"
      headingId={`${cta.id}-heading`}
      layout="center"
    />
  </Section>
</BaseLayout>
