---
// Wellness & Counselling Solutions page: a conversion funnel. Content: src/data/pages/wellness.ts
// (from copy/wellness-counselling.md). Order: hook → insight → why us → who it's for → what we do → free demo
// → pricing → what to expect → how it works → proof → FAQ → final ask. Demo is the primary action, audit the second.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPreview from '../../components/blocks/hero/HeroPreview.astro';
import Section from '../../components/blocks/Section.astro';
import BentoGrid from '../../components/blocks/BentoGrid.astro';
import FeatureList from '../../components/blocks/FeatureList.astro';
import ServiceIndex from '../../components/blocks/ServiceIndex.astro';
import IconGrid from '../../components/blocks/IconGrid.astro';
import DemoOffer from '../../components/blocks/DemoOffer.astro';
import PricingCard from '../../components/blocks/PricingCard.astro';
import ForkCallout from '../../components/blocks/ForkCallout.astro';
import Timeline from '../../components/blocks/Timeline.astro';
import Steps from '../../components/blocks/Steps.astro';
import ProofGrid from '../../components/blocks/ProofGrid.astro';
import Faq from '../../components/blocks/Faq.astro';
import CtaBlock from '../../components/blocks/CtaBlock.astro';
import Button from '../../components/Button.astro';
import IllusBooking from '../../components/illustrations/IllusBooking.astro';
import { breadcrumbSchema, howToSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { getCaseStudies } from '../../lib/case-studies';
import { siteConfig } from '../../data/site';
import { routes } from '../../data/routes';
import {
  seo,
  breadcrumb,
  hero,
  heroVariant,
  answerCapsule,
  insights,
  why,
  practices,
  services,
  demo,
  pricing,
  expect,
  howItWorks,
  realWork,
  faq,
  serviceNames,
  serviceOffers,
  cta,
} from '../../data/pages/wellness';

const work =
  import.meta.env.DEV || realWork.showInProduction ? await getCaseStudies({ tag: realWork.tag, limit: realWork.limit }) : [];

// Bands alternate canvas / lighter "alt". #real-work only renders when it has entries, so the bands after it flip.
const hasWork = work.length > 0;
const band = (lighter: boolean) => (lighter ? 'alt' : 'canvas');

const jsonLd = [
  breadcrumbSchema(breadcrumb),
  ...serviceSchema({ names: serviceNames, url: routes.wellnessCounselling, offers: serviceOffers }),
  howToSchema({
    name: howItWorks.heading,
    steps: howItWorks.items,
    url: new URL(`${routes.wellnessCounselling}#${howItWorks.id}`, siteConfig.url).toString(),
  }),
  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /solutions/wellness-counselling/?hero=statement | showcase | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['statement', 'showcase', 'visual']} />

  <!-- Insight: the answer capsule is the wide intro; the section's own line sits above the bento -->
  <Section id={insights.id} heading={insights.heading} intro={answerCapsule} introStyle="wide" tone="alt" align="start">
    <p class="mb-3 max-w-2xl text-pretty text-base font-medium text-ink md:mb-4 md:text-lg">{insights.intro}</p>
    <BentoGrid items={insights.items} cta={insights.cta} />
  </Section>

  <Section id={why.id} heading={why.heading} layout="split">
    {/* Oversized line art under the pinned heading: booking on a phone, compliance shield, local pin */}
    <IllusBooking
      slot="actions"
      class="pointer-events-none -ml-6 mt-4 hidden w-[24rem] max-w-none text-highlight opacity-30 [mask-image:radial-gradient(circle,#000_45%,transparent_80%)] lg:block"
    />
    <FeatureList items={why.items} columns={1} />
  </Section>

  <Section id={practices.id} heading={practices.heading} tone="alt" align="start">
    <ServiceIndex items={practices.items} art="none" />
    <p class="mt-3 text-pretty text-base text-ink-muted md:mt-4">{practices.note}</p>
  </Section>

  <Section id={services.id} heading={services.heading} align="start">
    <IconGrid items={services.items} columns={3} size="md" />
    <ForkCallout heading={services.labs.heading} text={services.labs.text} link={services.labs.link} class="mt-6 md:mt-8" />
  </Section>

  <!-- Primary conversion: the free demo -->
  <Section id={demo.id} labelledBy={`${demo.id}-heading`} tone="alt">
    <DemoOffer
      heading={demo.heading}
      headingId={`${demo.id}-heading`}
      text={demo.text}
      steps={demo.steps}
      cta={demo.cta}
      fallback={demo.fallback}
    />
  </Section>

  <Section id={pricing.id} heading={pricing.heading} intro={pricing.intro} align="start">
    <!-- Start with one, never both: website setup (featured) or Full Audit -->
    <div class="grid gap-3 md:grid-cols-2 md:gap-4">
      {pricing.start.map((item) => <PricingCard {...item} />)}
    </div>
    <!-- Then a plan -->
    <div class="mt-4 grid gap-3 border-t border-line pt-4 md:mt-6 md:grid-cols-2 md:gap-4 md:pt-6">
      {pricing.plans.map((item) => <PricingCard {...item} />)}
    </div>
    <p class="mt-3 max-w-4xl text-pretty text-meta text-ink-muted">{pricing.finePrint}</p>
    <ForkCallout heading={pricing.custom.heading} text={pricing.custom.text} link={pricing.custom.link} class="mt-6 md:mt-8" />
    <div class="mt-4 flex md:mt-6">
      <Button href={pricing.cta.href} variant="primary" size="base">{pricing.cta.label}</Button>
    </div>
  </Section>

  <Section id={expect.id} heading={expect.heading} intro={expect.intro} tone="alt" align="start">
    <Timeline items={expect.items} />
  </Section>

  <Section id={howItWorks.id} heading={howItWorks.heading}>
    <Steps items={howItWorks.items} />
  </Section>

  {
    hasWork && (
      <Section id={realWork.id} heading={realWork.heading} tone="alt" align="start">
        <ProofGrid entries={work} />
      </Section>
    )
  }

  <!-- Testimonials (tag wellness-counselling): renders nothing until real, permission-confirmed quotes exist -->

  <Section id={faq.id} heading={faq.heading} width="narrow" tone={band(!hasWork)}>
    <Faq faq={faq.items} />
  </Section>

  <!-- From the Blog (tag wellness-counselling, data: `blog` in wellness.ts): renders nothing until /resources has real posts -->

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow" tone={band(hasWork)}>
    <CtaBlock
      heading={cta.heading}
      text={cta.text}
      cta={cta.cta}
      link={cta.link}
      headingAs="h2"
      headingId={`${cta.id}-heading`}
      layout="center"
    />
  </Section>
</BaseLayout>
