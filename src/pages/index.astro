---
// Homepage. Content: src/data/pages/home.ts (from copy/home.md). Sections are added as they're rebuilt.
// The previous homepage is parked at src/pages/_inactive/home-2025.astro for reference.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPreview from '../components/blocks/hero/HeroPreview.astro';
import Section from '../components/blocks/Section.astro';
import IconGrid from '../components/blocks/IconGrid.astro';
import CardGrid from '../components/blocks/CardGrid.astro';
import NumberedList from '../components/blocks/NumberedList.astro';
import Pipeline from '../components/blocks/Pipeline.astro';
import ServiceGrid from '../components/blocks/ServiceGrid.astro';
import Steps from '../components/blocks/Steps.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import IllusAiShopping from '../components/illustrations/IllusAiShopping.astro';
import CtaBlock from '../components/blocks/CtaBlock.astro';
import ProofGrid from '../components/blocks/ProofGrid.astro';
import FeatureList from '../components/blocks/FeatureList.astro';
import Faq from '../components/blocks/Faq.astro';
import { getCaseStudies } from '../lib/case-studies';
import { howToSchema, faqSchema } from '../lib/schema';
import { siteConfig } from '../data/site';
import {
  seo,
  hero,
  heroVariant,
  answerCapsule,
  trust,
  industries,
  salesperson,
  why,
  services,
  howItWorks,
  ecommerce,
  labs,
  work,
  method,
  faq,
  cta,
} from '../data/pages/home';

const featuredWork =
  import.meta.env.DEV || work.showInProduction ? await getCaseStudies({ tag: work.tag, limit: work.limit }) : [];

// Sections alternate between the page background and a lighter band (tone "alt"), starting with the Trust Bar.
// #work is hidden in production until /portfolio exists, so the bands after it flip to keep alternating.
const hasWork = featuredWork.length > 0;
const band = (lighter: boolean) => (lighter ? 'alt' : 'canvas');

const jsonLd = [
  howToSchema({
    name: howItWorks.heading,
    steps: howItWorks.items,
    url: new URL(`/#${howItWorks.id}`, siteConfig.url).toString(),
  }),
  faqSchema(faq.items),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Dev-only preview: /?hero=split | centered | editorial | visual | all -->
  <HeroPreview content={hero} variant={heroVariant} options={['centered', 'split', 'editorial', 'visual']} />

  <!-- Trust Bar: answer capsule (AEO summary, plain text right under the Hero), then 4 trust signals -->
  <Section id={trust.id} tone="alt">
    <!-- Hidden on phones to keep the first scroll light; still in the HTML for search and AI crawlers -->
    <p class="mx-auto hidden max-w-3xl text-pretty text-center text-lead text-ink-soft sm:block">{answerCapsule}</p>
    <IconGrid items={trust.items} titleAs="p" class="sm:mt-6 md:mt-8" />
  </Section>

  <Section id={industries.id} heading={industries.heading} intro={industries.intro}>
    <CardGrid items={industries.items} columns={2} />
  </Section>

  <Section id={salesperson.id} heading={salesperson.heading} intro={salesperson.intro} tone="alt">
    <Pipeline items={salesperson.items} />
  </Section>

  <Section id={why.id} heading={why.heading} layout="split">
    <NumberedList items={why.items} />
  </Section>

  <Section id={services.id} eyebrow={services.eyebrow} heading={services.heading} tone="alt">
    <ServiceGrid items={services.items} />
  </Section>

  <Section id={howItWorks.id} heading={howItWorks.heading}>
    <Steps items={howItWorks.items} />
  </Section>

  <Section id={ecommerce.id} heading={ecommerce.heading} intro={ecommerce.body} layout="split" tone="alt">
    <Fragment slot="actions">
      <Button href={ecommerce.cta.href} variant="secondary" size="base">{ecommerce.cta.label}</Button>
      <ArrowLink href={ecommerce.link.href}>{ecommerce.link.label}</ArrowLink>
    </Fragment>
    <div class="relative">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_30%,transparent_100%)]"
      >
      </div>
      <IllusAiShopping class="mx-auto h-auto w-full max-w-2xl" />
    </div>
  </Section>

  <Section id={labs.id} heading={labs.heading} intro={labs.intro}>
    <IconGrid items={labs.items} columns={2} size="md" />
    <CtaBlock {...labs.cta} class="mt-4 md:mt-6" />
  </Section>

  {
    featuredWork.length > 0 && (
      <Section id={work.id} heading={work.heading} intro={work.intro} tone="alt">
        <ProofGrid entries={featuredWork} />
        <div class="mt-4 flex justify-center md:mt-6">
          <Button href={work.cta.href} variant="secondary" size="base">
            {work.cta.label}
          </Button>
        </div>
      </Section>
    )
  }

  <Section id={method.id} heading={method.heading} intro={method.intro} layout="split" tone={band(!hasWork)}>
    <FeatureList items={method.items} />
  </Section>

  <Section id={faq.id} heading={faq.heading} width="narrow" tone={band(hasWork)}>
    <Faq faq={faq.items} />
  </Section>

  <Section id={cta.id} labelledBy={`${cta.id}-heading`} width="narrow" tone={band(!hasWork)}>
    <CtaBlock heading={cta.heading} text={cta.text} cta={cta.cta} headingAs="h2" headingId={`${cta.id}-heading`} layout="center" />
  </Section>
</BaseLayout>
