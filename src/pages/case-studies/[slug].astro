---
// Case study detail template: one page per entry in src/content/case-studies/ (production: published entries only;
// placeholders get pages in `npm run dev` only). Shared labels: src/data/pages/case-studies.ts (copy/case-studies.md).
// Order: header (summary = answer capsule, live-site link) → hero image → story with a sticky aside (quick facts +
// results) → A Closer Look (gallery) → Before and After → testimonial (when approved) → audit CTA → more case studies.
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/blocks/Breadcrumb.astro';
import Section from '../../components/blocks/Section.astro';
import FactList from '../../components/blocks/FactList.astro';
import ProofGrid from '../../components/blocks/ProofGrid.astro';
import AuditCta from '../../components/blocks/AuditCta.astro';
import { breadcrumbSchema, caseStudySchema } from '../../lib/schema';
import { getCaseStudies, caseStudyHref, type CaseStudy } from '../../lib/case-studies';
import { routes } from '../../data/routes';
import { auditCta } from '../../data/pages/audit';
import { detail } from '../../data/pages/case-studies';
import { visibleTags } from '../../data/tags';

export async function getStaticPaths() {
  const entries = await getCaseStudies();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

interface Props {
  entry: CaseStudy;
  all: CaseStudy[];
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const href = caseStudyHref(entry);

const breadcrumb = [
  { label: 'Home', href: routes.home },
  { label: 'Case Studies', href: routes.caseStudies },
  { label: data.client, href },
];

const facts = [
  { term: detail.facts.client, value: data.client },
  data.industry && { term: detail.facts.industry, value: data.industry },
  data.services.length > 0 && { term: detail.facts.services, value: data.services.join(', ') },
  data.timeline && { term: detail.facts.timeline, value: data.timeline },
].filter(Boolean) as { term: string; value: string }[];

// Testimonial: only a permission-confirmed entry for this client
const testimonial = (await getCollection('testimonials')).find((t) => t.data.company === data.client);

const others = all.filter((e) => e.id !== entry.id).slice(0, 2);
const description = data.metaDescription ?? data.summary;
const shareImage = data.ogImage ?? data.image;

const jsonLd = [
  caseStudySchema({
    url: href,
    headline: data.title,
    description,
    image: shareImage?.src,
    client: { name: data.client, url: data.url },
  }),
  breadcrumbSchema(breadcrumb),
];

const [lead, ...restGallery] = data.gallery;
const tagChips = visibleTags(data.tags);
---

<BaseLayout
  title={detail.title(data.client)}
  description={description}
  ogImage={shareImage?.src}
  ogImageAlt={data.ogImage ? data.imageAlt ?? data.title : data.imageAlt}
  ogType="article"
  noIndex={data.placeholder}
  jsonLd={jsonLd}
>
  <!-- Header: the summary is the page's answer capsule -->
  <section aria-labelledby="cs-title" class="relative isolate px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_70%_70%_at_20%_0%,#000_30%,transparent_100%)]"></div>
    <div class="mx-auto w-full max-w-site">
      <Breadcrumb items={breadcrumb} class="mb-3" />
      <p class="flex items-center gap-1 text-meta font-medium text-ink-muted">
        <span aria-hidden="true" class="size-1 shrink-0 rounded-full bg-accent"></span>
        {detail.eyebrow}
        {data.placeholder && <span class="ml-1 rounded-pill bg-accent px-1.5 text-xs font-semibold text-accent-ink">Placeholder</span>}
      </p>
      {
        tagChips.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {tagChips.map((t) => (
              <li>
                <a
                  href={t.href}
                  class="inline-flex min-h-[2rem] items-center rounded-pill border border-line-strong px-2 text-meta font-medium text-ink-soft transition-colors hover:border-highlight/50 hover:text-highlight focus-visible:outline-2 focus-visible:outline-highlight"
                >
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <h1 id="cs-title" class="mt-3 max-w-5xl text-balance font-display text-[clamp(2.25rem,1.25rem+3.5vw,4.25rem)] font-bold leading-[1.05] tracking-tight text-ink">
        {data.title}
      </h1>
      <div class="mt-5 grid gap-4 border-t border-line pt-4 md:mt-8 md:pt-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
        <p class="max-w-3xl text-pretty text-lead text-ink-soft">{data.summary}</p>
        {
          data.url && (
            <a
              href={data.url}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center gap-1 self-start font-semibold text-highlight transition-colors hover:text-ink lg:self-end"
            >
              {detail.liveSiteLabel}
              <svg class="size-icon-sm" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 2.5h5v5M9.5 2.5l-7 7" />
              </svg>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          )
        }
      </div>
      {
        data.image && (
          <div class="mt-6 overflow-hidden rounded-card border border-line-strong md:mt-10">
            <Image
              src={data.image}
              alt={data.imageAlt ?? ''}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1280px) 1280px, 100vw"
              loading="eager"
              class="h-auto w-full"
            />
          </div>
        )
      }
    </div>
  </section>

  <!-- The story, with quick facts and results pinned beside it on lg (above it on phones) -->
  <Section id="story" tone="alt" labelledBy="cs-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-12">
      <aside class="flex flex-col gap-6 lg:order-2 lg:sticky lg:top-32 lg:self-start">
        {
          data.results.length > 0 && (
            <div>
              <p class="text-meta font-semibold uppercase tracking-wider text-highlight">{detail.resultsEyebrow}</p>
              <ul class="mt-2 grid gap-2">
                {data.results.map((r) => (
                  <li class="rounded-card border border-highlight/30 bg-surface-raised px-3 py-2 font-display text-xl font-bold leading-snug text-ink md:text-2xl">
                    {r}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <FactList items={facts} columns={1} />
      </aside>
      <div class="cs-prose max-w-3xl lg:order-1">
        <Content />
      </div>
    </div>
  </Section>

  {
    data.gallery.length > 0 && (
      <Section id="closer-look" heading={detail.galleryHeading} align="start">
        <div class="grid gap-3 md:grid-cols-2 md:gap-4">
          {lead && (
            <figure class="overflow-hidden rounded-card border border-line-strong md:col-span-2">
              <Image src={lead.image} alt={lead.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1280px) 1280px, 100vw" class="h-auto w-full" />
            </figure>
          )}
          {restGallery.map((g) => (
            <figure class="overflow-hidden rounded-card border border-line-strong">
              <Image src={g.image} alt={g.alt} widths={[480, 640, 960]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full" />
            </figure>
          ))}
        </div>
      </Section>
    )
  }

  {
    data.beforeImage && data.image && (
      <Section id="before-after" heading={detail.beforeAfter.heading} tone={data.gallery.length > 0 ? 'alt' : 'canvas'} align="start">
        <div class="grid gap-4 md:grid-cols-2 md:gap-6">
          {[
            { label: detail.beforeAfter.before, src: data.beforeImage, alt: data.beforeImageAlt ?? '', tone: 'border-line-strong text-ink-muted' },
            { label: detail.beforeAfter.after, src: data.image, alt: data.imageAlt ?? '', tone: 'border-highlight/40 text-highlight' },
          ].map((side) => (
            <figure class="flex flex-col gap-2">
              <figcaption>
                <span class={`inline-flex rounded-pill border px-2 py-0.5 text-meta font-semibold uppercase tracking-wider ${side.tone}`}>
                  {side.label}
                </span>
              </figcaption>
              <div class="overflow-hidden rounded-card border border-line-strong">
                <Image src={side.src} alt={side.alt} widths={[480, 640, 960]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full" />
              </div>
            </figure>
          ))}
        </div>
      </Section>
    )
  }

  {
    testimonial && (
      <Section id="testimonial" width="narrow" labelledBy="cs-title">
        <figure class="border-l-2 border-accent/70 pl-3 md:pl-5">
          <blockquote class="text-pretty font-display text-2xl font-medium leading-snug text-ink md:text-3xl">
            {testimonial.data.quote}
          </blockquote>
          <figcaption class="mt-3 text-base text-ink-soft">
            <strong class="font-semibold text-ink">{testimonial.data.name}</strong>
            {testimonial.data.role && `, ${testimonial.data.role}`}
          </figcaption>
        </figure>
      </Section>
    )
  }

  <Section id="cta" labelledBy="cs-cta-heading">
    <AuditCta
      heading={detail.cta.heading}
      text={detail.cta.text}
      fieldLabel={auditCta.fieldLabel}
      placeholder={auditCta.placeholder}
      button={detail.cta.button}
      action={auditCta.action}
      headingAs="h2"
      headingId="cs-cta-heading"
    />
  </Section>

  {
    others.length > 0 && (
      <Section id="more" heading={detail.moreHeading} tone="alt" align="start">
        <ProofGrid entries={others} />
      </Section>
    )
  }
</BaseLayout>

<style>
  /* Case study body (markdown): readable measure, clear hierarchy, theme tokens only */
  .cs-prose :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-ink);
  }
  .cs-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .cs-prose :global(h3) {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
  }
  .cs-prose :global(p),
  .cs-prose :global(ul) {
    margin-top: 1rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .cs-prose :global(h2 + p),
  .cs-prose :global(h3 + p) {
    margin-top: 0.75rem;
  }
  .cs-prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .cs-prose :global(li::marker) {
    color: var(--color-highlight);
  }
  .cs-prose :global(strong) {
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .cs-prose :global(p),
    .cs-prose :global(ul) {
      font-size: var(--text-lg);
    }
  }
</style>
