---
// Article template: one page per entry in src/content/articles/ (production: published entries only; drafts get pages
// in `npm run dev` only, noindex). Shared labels: src/data/pages/articles.ts (copy/articles.md, "Article template").
// Order: breadcrumb → header (topic chip, H1, byline, reading time) → The Short Answer → image → Key Takeaways →
// In This Article (sticky beside the body on lg, collapsed above it on phones) + body → FAQ → About the author →
// audit CTA → Keep Reading. Dates come from git (SeoHead), never shown on the page.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/blocks/Breadcrumb.astro';
import Section from '../../components/blocks/Section.astro';
import Faq from '../../components/blocks/Faq.astro';
import AuditCta from '../../components/blocks/AuditCta.astro';
import ArticleGrid from '../../components/blocks/ArticleGrid.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { blogPostingSchema, breadcrumbSchema, faqSchema, founderSchema } from '../../lib/schema';
import { getArticles, articleHref, articleTitleTag, readingMinutes, type Article } from '../../lib/articles';
import { routes } from '../../data/routes';
import { auditCta } from '../../data/pages/audit';
import { detail, minReadLabel } from '../../data/pages/articles';
import { visibleTags } from '../../data/tags';

export async function getStaticPaths() {
  const entries = await getArticles();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

interface Props {
  entry: Article;
  all: Article[];
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
// Markdown articles: render the content layer's HTML minus <!-- build notes --> (they stay in the file, never in
// the page source). MDX entries fall back to <Content />.
// External links in the body open in a new tab (founder, Nov 3); links to our own pages stay in the same tab.
const html = entry.rendered?.html
  ?.replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<a href="(https?:\/\/[^"]+)"/g, '<a href="$1" target="_blank" rel="noopener"');
const href = articleHref(entry);
const topic = visibleTags(data.tags)[0];
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const breadcrumb = [
  { label: 'Home', href: routes.home },
  { label: 'Articles', href: routes.articles },
  { label: data.title, href },
];

// Keep Reading (only when 2+ published): same topic first, then the newest others, max 3
const others = all.filter((e) => e.id !== entry.id);
const sameTopic = (e: Article) => e.data.tags.some((t) => data.tags.includes(t));
const keepReading = [...others.filter(sameTopic), ...others.filter((e) => !sameTopic(e))].slice(0, 3);

const shareImage = data.ogImage ?? data.image;

const jsonLd = [
  blogPostingSchema({ url: href, headline: data.title, description: data.description, image: shareImage?.src, about: topic?.label }),
  founderSchema(),
  breadcrumbSchema(breadcrumb),
  ...(data.faq?.length ? [faqSchema(data.faq)] : []),
];
---

<BaseLayout
  title={articleTitleTag(entry)}
  description={data.description}
  ogImage={shareImage?.src}
  ogImageAlt={shareImage ? data.imageAlt ?? data.title : undefined}
  ogType="article"
  noIndex={data.draft}
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section aria-labelledby="article-title" class="relative isolate px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-8 lg:px-4 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,#000_30%,transparent_100%)]"></div>
    <div class="mx-auto w-full max-w-4xl">
      <Breadcrumb items={breadcrumb} class="mb-3" />
      <div class="flex flex-wrap items-center gap-1.5">
        {data.draft && <p class="rounded-pill bg-accent px-2 py-1 text-xs font-semibold text-accent-ink">Draft</p>}
        {
          topic && (
            <a
              href={topic.href}
              class="rounded-pill border border-highlight/30 bg-highlight/10 px-2 py-1 text-meta font-medium text-highlight transition-colors hover:border-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight"
            >
              {topic.label}
            </a>
          )
        }
      </div>
      <h1 id="article-title" class="mt-3 text-balance font-display text-heading font-bold text-ink md:text-5xl">{data.title}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-meta text-ink-muted">
        <span>
          {detail.byline.by}
          <a href={detail.byline.href} class="font-semibold text-ink-soft underline decoration-line-strong underline-offset-4 transition-colors hover:text-highlight hover:decoration-highlight">
            {detail.byline.name}, {detail.byline.role}
          </a>
        </span>
        <span aria-hidden="true" class="text-line-strong">·</span>
        <span>{readingMinutes(entry)} {minReadLabel}</span>
      </p>

      <!-- The Short Answer: the answer capsule, real text in the raw HTML -->
      <div class="mt-6 rounded-card border border-line-strong border-l-2 border-l-accent bg-surface-lifted p-3 md:mt-8 md:p-4">
        <p class="text-meta font-semibold uppercase tracking-wider text-accent">{detail.shortAnswer}</p>
        <p class="mt-1.5 text-pretty text-base leading-relaxed text-ink md:text-lg md:leading-relaxed">{data.summary}</p>
      </div>
    </div>
  </section>

  <div class="px-2 pb-6 sm:px-3 md:pb-10 lg:px-4 lg:pb-16">
    <div class="mx-auto w-full max-w-site">
      {
        data.image && (
          <div class="mx-auto mb-6 max-w-5xl overflow-hidden rounded-card border border-line-strong md:mb-10">
            <Image src={data.image} alt={data.imageAlt ?? ''} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 1024px, 100vw" class="aspect-[16/10] w-full object-cover" />
          </div>
        )
      }

      <div class:list={['grid gap-4 md:gap-6', showToc ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] lg:gap-12' : 'mx-auto max-w-3xl']}>
        {
          showToc && (
            <>
              {/* Phones and tablets: collapsed above the body */}
              <details class="group rounded-card border border-line-strong bg-surface-lifted lg:hidden">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                  {detail.inThisArticle}
                  <svg class="size-icon-sm shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5 6 7.5 9 4.5" />
                  </svg>
                </summary>
                <ol class="flex flex-col border-t border-line px-3 pb-2 pt-1">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="block py-1.5 text-meta text-ink-soft hover:text-highlight">{h.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
              {/* Desktop: sticky beside the body */}
              <nav aria-labelledby="toc-heading" class="hidden lg:sticky lg:top-32 lg:block lg:self-start">
                <h2 id="toc-heading" class="text-meta font-semibold uppercase tracking-wider text-ink-muted">{detail.inThisArticle}</h2>
                <ol class="mt-2 flex flex-col border-l border-line">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="-ml-px block border-l border-transparent py-1 pl-2 text-meta text-ink-soft transition-colors hover:border-highlight hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight/50"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </>
          )
        }

        <div class="min-w-0 max-w-3xl">
          {
            data.takeaways?.length ? (
              <div class="mb-6 rounded-card border border-line-strong bg-surface-lifted p-3 md:mb-8 md:p-4">
                <h2 class="font-display text-xl font-bold text-ink">{detail.keyTakeaways}</h2>
                <ul class="mt-2 flex flex-col gap-1.5">
                  {data.takeaways.map((t) => (
                    <li class="flex items-start gap-2 text-pretty text-base text-ink-soft">
                      <span aria-hidden="true" class="mt-[0.7em] size-[0.375rem] shrink-0 rounded-full bg-highlight/70" />
                      <span>{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }
          <div class="article-prose">
            {html ? <Fragment set:html={html} /> : <Content />}
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    data.faq?.length ? (
      <Section id="faq" heading={detail.faqHeading} width="narrow">
        <Faq faq={data.faq} />
      </Section>
    ) : null
  }

  <!-- About the author -->
  <Section id="author" width="prose">
    <div class="flex flex-col gap-2 border-l-2 border-highlight pl-3">
      <p class="text-pretty text-base text-ink-soft md:text-lg">{detail.author.text}</p>
      <ArrowLink href={detail.author.link.href} class="self-start">{detail.author.link.label}</ArrowLink>
    </div>
  </Section>

  <Section id="cta" labelledBy="cta-heading">
    <AuditCta
      heading={detail.cta.heading}
      text={detail.cta.text}
      fieldLabel={auditCta.fieldLabel}
      placeholder={auditCta.placeholder}
      button={detail.cta.button}
      action={auditCta.action}
      headingAs="h2"
      headingId="cta-heading"
    />
  </Section>

  {
    keepReading.length > 0 && (
      <Section id="keep-reading" heading={detail.keepReading}>
        <ArticleGrid entries={keepReading} />
        <div class="mt-4 flex justify-center md:mt-6">
          <ArrowLink href={detail.allArticles.href}>{detail.allArticles.label}</ArrowLink>
        </div>
      </Section>
    )
  }
</BaseLayout>

<style>
  /* Article body (markdown): readable measure, clear hierarchy, tables that scroll on phones; theme tokens only */
  .article-prose :global(h2) {
    margin-top: 3rem;
    scroll-margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-ink);
  }
  .article-prose > :global(:first-child) {
    margin-top: 0;
  }
  .article-prose :global(h3) {
    margin-top: 2rem;
    scroll-margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
  }
  .article-prose :global(p),
  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-top: 1rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .article-prose :global(h2 + p),
  .article-prose :global(h3 + p),
  .article-prose :global(h3 + ul) {
    margin-top: 0.75rem;
  }
  .article-prose :global(ul),
  .article-prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }
  .article-prose :global(ul) {
    list-style: disc;
  }
  .article-prose :global(ol) {
    list-style: decimal;
  }
  .article-prose :global(li::marker) {
    color: var(--color-highlight);
  }
  .article-prose :global(strong) {
    color: var(--color-ink);
  }
  .article-prose :global(a) {
    color: var(--color-highlight);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-highlight) 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .article-prose :global(a:hover) {
    text-decoration-color: var(--color-highlight);
  }
  .article-prose :global(table) {
    display: block;
    max-width: 100%;
    margin-top: 1.25rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-meta);
    line-height: 1.5;
  }
  .article-prose :global(th),
  .article-prose :global(td) {
    min-width: 10rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
    color: var(--color-ink-soft);
  }
  .article-prose :global(th) {
    border-bottom-color: var(--color-line-strong);
    font-weight: 600;
    color: var(--color-ink);
  }
  .article-prose :global(td:first-child) {
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .article-prose :global(p),
    .article-prose :global(ul),
    .article-prose :global(ol) {
      font-size: var(--text-lg);
    }
    .article-prose :global(table) {
      font-size: var(--text-base);
    }
  }
</style>
