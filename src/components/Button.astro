---
import clsx from 'clsx';

// Renders a real <a> when `href` is set (navigation) and a <button> otherwise (forms, actions).
// Never wrap a Button in an <a>.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  className,
  type = 'button',
  ...rest
} = Astro.props;

const isExternal = href?.startsWith('http');

const base =
  'inline-flex items-center justify-center gap-1 rounded-control font-semibold text-center transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-canvas disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary: 'bg-accent text-accent-ink hover:opacity-90 hover:shadow-glow-accent focus-visible:ring-accent/50',
  secondary: 'bg-transparent border border-accent text-accent hover:bg-accent/10 focus-visible:ring-accent/50',
  tertiary: 'bg-transparent text-ink hover:bg-white/5 focus-visible:ring-white/20',
};

// Every size keeps a 44px minimum touch target.
const sizes = {
  sm: 'min-h-11 px-4 py-1.5 text-sm',
  md: 'min-h-11 px-4 py-3 text-base',
  lg: 'min-h-14 px-6 py-4 text-lg',
};

const classes = clsx(base, variants[variant], sizes[size], fullWidth && 'w-full', className);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener' : undefined}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
