---
import logo from '../assets/fadeaway-logo-2.png';
import { footerColumns, socialLinks, legalLinks } from '../data/navigation';

const currentYear = new Date().getFullYear();
const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, '');
---

<footer class="bg-fadeaway-graphite border-t border-white/5">
  <div class="container-max section-padding">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mb-8">
      {/* Brand Column */}
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 hover:opacity-80 transition-opacity">
          <img src={logo.src} alt="Fadeaway Creatives" class="h-10 w-auto" />
        </a>
        <p class="text-neutral-400 text-sm mb-3">We Build Websites That Perform.</p>
        <p class="text-neutral-500 text-xs">Vancouver, BC – Working with clients across Canada and the USA.</p>
      </div>

      {/* Dynamic Navigation Columns */}
      {footerColumns.map((col) => (
        <div>
          <h4 class="text-neutral-50 font-semibold mb-4 text-base">{col.title}</h4>
          <ul class="space-y-2 text-sm">
            {col.links.map((link) => {
              const isActive = normalizedPath === link.href;
              return (
                <li>
                  <a
                    href={link.href}
                    class={`transition-colors ${
                      isActive
                        ? 'text-fadeaway-teal font-semibold'
                        : 'text-neutral-400 hover:text-fadeaway-teal'
                    }`}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    {/* Social Links Row */}
    <div class="flex items-center gap-4 mb-8">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto:') ? '_self' : '_blank'}
          rel="noopener"
          class="w-8 h-8 flex items-center justify-center bg-white/5 hover:bg-fadeaway-teal/20 text-neutral-400 hover:text-fadeaway-teal rounded-lg transition-colors"
          aria-label={link.name}
        >
          {link.platform === 'instagram' && (
            <svg class="w-4 h-4 text-fadeaway-teal" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" /></svg>
          )}
          {link.platform === 'facebook' && (
            <svg class="w-4 h-4 text-fadeaway-teal" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.312h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" /></svg>
          )}
          {link.platform === 'email' && (
            <svg class="w-4 h-4 text-fadeaway-teal" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" /><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" /></svg>
          )}
        </a>
      ))}
    </div>

    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-neutral-400">
      <p>&copy; {currentYear} Fadeaway Creatives. All rights reserved.</p>
      <div class="flex gap-6 mt-4 md:mt-0">
        {legalLinks.map((link) => (
          <a href={link.href} class="hover:text-fadeaway-teal transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
