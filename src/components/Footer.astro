---
// Site footer. Copy from copy/home.md (Footer section) via src/data/navigation.ts.
// Mobile-first: brand block, then link columns in 2 columns, 3 from sm, brand + 3 from lg.
import Logo from './ui/Logo.astro';
import SocialIcon from './ui/SocialIcon.astro';
import { footerColumns, footerSocial, footerTagline } from '../data/navigation';
import { siteConfig } from '../data/site';

// Page URLs end in a slash sitewide (routes.ts), so compare in that form
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const year = new Date().getFullYear();

const linkClass =
  'inline-flex min-h-11 items-center text-sm text-ink-muted transition-colors hover:text-highlight focus-visible:outline-2 focus-visible:outline-highlight aria-[current=page]:font-semibold aria-[current=page]:text-highlight';
---

<footer class="border-t border-line bg-canvas px-2 pb-4 pt-6 sm:px-3 md:pt-8 lg:px-4">
  <div class="mx-auto max-w-site">
    <div class="grid gap-4 lg:grid-cols-[1.5fr_repeat(3,1fr)] lg:gap-6">
      <div class="flex flex-col gap-2">
        <Logo class="h-10 w-auto" />
        <p class="max-w-xs text-sm text-ink-muted">{footerTagline}</p>
        <p class="max-w-xs text-xs text-ink-subtle">{siteConfig.locationLine}</p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:col-span-3 lg:gap-6">
        {
          footerColumns.map((col) => (
            <nav aria-label={col.title}>
              <p class="mb-1 font-display text-base font-semibold text-ink">{col.title}</p>
              <ul>
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class={linkClass}
                      aria-current={link.href === current ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-4 flex flex-col gap-2 border-t border-line pt-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-1">
        {
          footerSocial.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              aria-label={link.name}
              class="inline-flex size-11 items-center justify-center rounded-control text-highlight transition-colors hover:bg-highlight/10 focus-visible:outline-2 focus-visible:outline-highlight"
            >
              <SocialIcon platform={link.platform} />
            </a>
          ))
        }
        <a href={`mailto:${siteConfig.email}`} class={`${linkClass} ml-1`}>
          {siteConfig.email}
        </a>
      </div>

      <p class="text-xs text-ink-subtle">&copy; {year} {siteConfig.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
