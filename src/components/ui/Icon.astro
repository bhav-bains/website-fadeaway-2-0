---
// Shared line icons (24px grid, 1.75 stroke, currentColor). Decorative by default.
// Add new icons to `icons` and to the IconName type.
export type IconName = 'search-ai' | 'award' | 'industries' | 'chart-up' | 'price-tag' | 'map-pin';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-icon' } = Astro.props;

const icons: Record<IconName, string> = {
  // magnifier with a sparkle: search + AI answers
  'search-ai':
    '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/><path d="M10.5 7.2l.85 2.45 2.45.85-2.45.85-.85 2.45-.85-2.45-2.45-.85 2.45-.85z"/>',
  // ribbon medal: experience
  award:
    '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1"/><path d="m12 6.5.9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2L9.1 8.6l2-.3z"/>',
  // four tiles: the industries served
  industries:
    '<rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/>',
  // rising bars with trend arrow: bookings and sales
  'chart-up':
    '<path d="M4 20h16"/><path d="M6.5 16v-3M11 16v-5.5M15.5 16V8.5"/><path d="m5 9.5 5-4.5 3 2.5L19 3"/><path d="M15 3h4v4"/>',
  'price-tag':
    '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>',
  'map-pin':
    '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
