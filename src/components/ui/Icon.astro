---
// Shared line icons (24px grid, 1.75 stroke, currentColor). Decorative by default.
// Add new icons to `icons` and to the IconName type.
export type IconName =
  | 'search-ai'
  | 'award'
  | 'industries'
  | 'chart-up'
  | 'price-tag'
  | 'map-pin'
  | 'browser'
  | 'code'
  | 'refresh'
  | 'bag'
  | 'migrate'
  | 'target'
  | 'megaphone'
  | 'bulb'
  | 'workflow'
  | 'sparkles'
  | 'dashboard';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-icon' } = Astro.props;

const icons: Record<IconName, string> = {
  // magnifier with a sparkle: search + AI answers
  'search-ai':
    '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/><path d="M10.5 7.2l.85 2.45 2.45.85-2.45.85-.85 2.45-.85-2.45-2.45-.85 2.45-.85z"/>',
  // ribbon medal: experience
  award:
    '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1"/><path d="m12 6.5.9 1.8 2 .3-1.45 1.4.35 2-1.8-.95-1.8.95.35-2L9.1 8.6l2-.3z"/>',
  // four tiles: the industries served
  industries:
    '<rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/>',
  // rising bars with trend arrow: bookings and sales
  'chart-up':
    '<path d="M4 20h16"/><path d="M6.5 16v-3M11 16v-5.5M15.5 16V8.5"/><path d="m5 9.5 5-4.5 3 2.5L19 3"/><path d="M15 3h4v4"/>',
  'price-tag':
    '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>',
  'map-pin':
    '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  browser: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M6.5 6.5h.01M9 6.5h.01"/>',
  code: '<path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m13.5 5-3 14"/>',
  // circular arrows: redesign
  refresh:
    '<path d="M20 11a8 8 0 0 0-14.8-4.2L3 9"/><path d="M3 4v5h5"/><path d="M4 13a8 8 0 0 0 14.8 4.2L21 15"/><path d="M21 20v-5h-5"/>',
  // shopping bag: e-commerce
  bag: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  // two-way arrows: site migration
  migrate: '<path d="M4 8h13"/><path d="m14 5 3 3-3 3"/><path d="M20 16H7"/><path d="m10 13-3 3 3 3"/>',
  // bullseye: conversion
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  // megaphone: paid ads
  megaphone: '<path d="M4 10v4h3l7 4V6l-7 4z"/><path d="M7 14v4.5a1.5 1.5 0 0 0 3 0V15.7"/><path d="M18 9.5a3.5 3.5 0 0 1 0 5"/>',
  // lightbulb: idea to MVP
  bulb: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>',
  // three connected nodes: process automation
  workflow:
    '<rect x="3" y="4" width="6" height="6" rx="1.5"/><rect x="15" y="4" width="6" height="6" rx="1.5"/><rect x="9" y="15" width="6" height="6" rx="1.5"/><path d="M9 7h6M6 10v2.5a2 2 0 0 0 2 2h1M18 10v2.5a2 2 0 0 1-2 2h-1"/>',
  // two sparkles: AI tools
  sparkles:
    '<path d="M10 3.5l1.6 4.4L16 9.5l-4.4 1.6L10 15.5l-1.6-4.4L4 9.5l4.4-1.6z"/><path d="M18 14l.8 2.2 2.2.8-2.2.8L18 20l-.8-2.2L15 17l2.2-.8z"/>',
  // panels with a chart: apps and dashboards
  dashboard:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/><path d="m12 17 2.5-3 2 1.5L19 12"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
