---
// Site header. One nav list for every screen size (mobile-first):
// - phone/tablet: menu button opens a panel; dropdowns expand in place
// - lg and up: links inline; dropdowns open on hover or click
// State lives in data-open attributes set by the script below.
import Logo from './ui/Logo.astro';
import Button from './Button.astro';
import { mainNavigation, headerCta } from '../data/navigation';

// Page URLs end in a slash sitewide (routes.ts), so compare in that form
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => (href === current ? 'page' : undefined);
const slug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const itemClass =
  'flex min-h-11 w-full items-center gap-1.5 rounded-control px-2 text-base font-medium text-ink-soft transition-colors hover:bg-white/5 hover:text-ink focus-visible:outline-2 focus-visible:outline-highlight aria-[current=page]:text-ink lg:w-auto lg:text-sm';
const subLinkClass =
  'flex min-h-11 items-center rounded-control px-2 text-base text-ink-muted transition-colors hover:bg-white/5 hover:text-ink focus-visible:outline-2 focus-visible:outline-highlight aria-[current=page]:text-ink lg:text-sm';
---

<header id="site-header" class="group/header absolute inset-x-0 top-0 z-[100] px-2 pt-2 sm:px-3 lg:px-4 lg:pt-3">
  <div class="relative mx-auto max-w-site">
    <div
      class="flex items-center justify-between gap-2 rounded-xl border border-line bg-black/30 px-2 py-1 shadow-lg backdrop-blur-md lg:px-3"
    >
      <Logo class="h-8 w-auto lg:h-10" eager />

      <nav
        id="site-nav"
        aria-label="Main"
        class="absolute inset-x-0 top-full mt-1 hidden max-h-[calc(100dvh-6rem)] flex-col gap-2 overflow-y-auto rounded-xl border border-line bg-surface-raised/95 p-2 shadow-2xl backdrop-blur-lg group-data-open/header:flex lg:static lg:mt-0 lg:flex lg:max-h-none lg:flex-row lg:items-center lg:overflow-visible lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none lg:backdrop-blur-none"
      >
        <ul class="flex flex-col gap-0.5 lg:flex-row lg:items-center lg:gap-0.5">
          {
            mainNavigation.map((item) =>
              item.type === 'link' ? (
                <li>
                  <a href={item.href} class={itemClass} aria-current={isCurrent(item.href)}>
                    {item.label}
                  </a>
                </li>
              ) : (
                <li class="group/menu relative" data-menu>
                  <button
                    type="button"
                    class={`${itemClass} justify-between lg:justify-start`}
                    aria-expanded="false"
                    aria-controls={`menu-${slug(item.label)}`}
                  >
                    {item.label}
                    <svg
                      class="size-icon-xs shrink-0 text-ink-subtle transition-transform duration-200 group-data-open/menu:rotate-180 lg:group-hover/menu:rotate-180"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5 6 7.5 9 4.5" />
                    </svg>
                  </button>

                  <div
                    id={`menu-${slug(item.label)}`}
                    class="hidden group-data-open/menu:block lg:absolute lg:left-1/2 lg:top-full lg:-translate-x-1/2 lg:pt-1 lg:group-hover/menu:block"
                  >
                    <div class="ml-1 mt-0.5 border-l border-line pl-1 lg:ml-0 lg:mt-0 lg:rounded-xl lg:border lg:bg-surface-raised lg:p-2 lg:shadow-2xl">
                      {item.type === 'features' ? (
                        <ul class="grid gap-0.5 lg:w-max lg:grid-cols-2 lg:gap-1">
                          {item.features.map((feature) => (
                            <li>
                              <a
                                href={feature.href}
                                class="group/card flex flex-col gap-1 rounded-lg p-2 transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-highlight lg:w-60"
                                aria-current={isCurrent(feature.href)}
                              >
                                <span class="flex items-center gap-1 font-display text-lg font-bold text-ink transition-colors group-hover/card:text-accent lg:text-xl">
                                  {feature.label}
                                  <svg
                                    class="size-icon-sm -translate-x-1 opacity-0 transition-all duration-200 group-hover/card:translate-x-0 group-hover/card:opacity-100"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    aria-hidden="true"
                                  >
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                                  </svg>
                                </span>
                                <ul class="flex flex-col gap-0.5 text-meta text-ink-muted">
                                  {feature.includes.map((name) => <li>{name}</li>)}
                                </ul>
                              </a>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <ul class="flex flex-col gap-0.5 lg:min-w-56">
                          {item.links.map((link) => (
                            <li>
                              <a href={link.href} class={subLinkClass} aria-current={isCurrent(link.href)}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                </li>
              ),
            )
          }
        </ul>

        <div class="border-t border-line pt-2 lg:hidden">
          <Button href={headerCta.href} variant="primary" size="md" fullWidth>
            {headerCta.label}
          </Button>
        </div>
      </nav>

      <div class="flex items-center gap-1">
        <!-- Desktop CTA; on smaller screens the CTA lives inside the menu panel -->
        <div class="hidden lg:block">
          <Button href={headerCta.href} variant="secondary" size="sm">
            {headerCta.label}
          </Button>
        </div>

        <button
          type="button"
          data-nav-toggle
          class="inline-flex size-11 items-center justify-center rounded-control border border-line text-ink transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-highlight lg:hidden"
          aria-controls="site-nav"
          aria-expanded="false"
        >
          <span class="sr-only">Menu</span>
          <svg class="size-icon group-data-open/header:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="hidden size-icon group-data-open/header:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menus = header ? [...header.querySelectorAll<HTMLElement>('[data-menu]')] : [];
  const desktop = window.matchMedia('(min-width: 64rem)');

  function setNavOpen(open: boolean) {
    if (!header || !toggle) return;
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    // Stop the page scrolling behind the open phone menu
    document.documentElement.classList.toggle('overflow-hidden', open && !desktop.matches);
  }

  function setMenuOpen(menu: HTMLElement, open: boolean) {
    menu.toggleAttribute('data-open', open);
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
  }

  function closeMenus(except?: HTMLElement) {
    menus.forEach((menu) => menu !== except && setMenuOpen(menu, false));
  }

  toggle?.addEventListener('click', () => setNavOpen(!header?.hasAttribute('data-open')));

  menus.forEach((menu) => {
    menu.querySelector('button')?.addEventListener('click', () => {
      const open = !menu.hasAttribute('data-open');
      if (desktop.matches) closeMenus(menu);
      setMenuOpen(menu, open);
    });
  });

  header?.querySelectorAll('#site-nav a').forEach((link) => {
    link.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMenus();
    if (header?.hasAttribute('data-open')) {
      setNavOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (desktop.matches && header && !header.contains(event.target as Node)) closeMenus();
  });

  desktop.addEventListener('change', () => {
    setNavOpen(false);
    closeMenus();
  });
</script>
