---
// Long-form legal document (Privacy, Terms): a quiet header (breadcrumb, H1, visible effective date, intro), then
// a sticky table of contents on lg beside the prose. Each section is an H2 with an anchor; paragraphs and lists are
// plain text in the HTML. Readable measure, generous line height, no decoration beyond a faint grid in the header.
import Breadcrumb, { type BreadcrumbItem } from './Breadcrumb.astro';

export interface LegalSection {
  id: string;
  heading: string;
  paragraphs?: string[];
  list?: string[];
  /** Paragraphs after the list */
  paragraphs_after?: string[];
}

export interface LegalDocContent {
  title: string;
  description: string;
  h1: string;
  intro: string;
  effectiveDate: string;
  sections: LegalSection[];
}

interface Props {
  doc: LegalDocContent;
  breadcrumb: BreadcrumbItem[];
  /** Label before the date, e.g. "Effective date:" */
  dateLabel: string;
  /** Heading for the table of contents */
  tocLabel: string;
}

const { doc, breadcrumb, dateLabel, tocLabel } = Astro.props;
---

<section aria-labelledby="legal-title" class="relative isolate border-b border-line px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pt-40">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,#000_30%,transparent_100%)]"></div>
  <div class="mx-auto w-full max-w-site">
    <Breadcrumb items={breadcrumb} class="mb-3" />
    <h1 id="legal-title" class="font-display text-heading font-bold text-ink md:text-5xl">{doc.h1}</h1>
    <p class="mt-2 text-meta text-ink-muted">
      {dateLabel} <time>{doc.effectiveDate}</time>
    </p>
    <p class="mt-4 max-w-3xl text-pretty text-lead text-ink-soft">{doc.intro}</p>
  </div>
</section>

<div class="px-2 py-6 sm:px-3 md:py-10 lg:px-4 lg:py-16">
  <div class="mx-auto grid w-full max-w-site gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] lg:gap-12">
    <nav aria-labelledby="legal-toc" class="lg:sticky lg:top-32 lg:self-start">
      <h2 id="legal-toc" class="text-meta font-semibold uppercase tracking-wider text-ink-muted">{tocLabel}</h2>
      <ol class="mt-2 flex flex-col border-l border-line">
        {
          doc.sections.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                class="-ml-px block border-l border-transparent py-1 pl-2 text-meta text-ink-soft transition-colors hover:border-highlight hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight/50"
              >
                {s.heading}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="flex max-w-3xl flex-col gap-6 md:gap-8">
      {
        doc.sections.map((s) => (
          <section id={s.id} aria-labelledby={`${s.id}-heading`} class="scroll-mt-28 border-t border-line pt-4 md:pt-6">
            <h2 id={`${s.id}-heading`} class="font-display text-2xl font-bold text-ink">
              {s.heading}
            </h2>
            <div class="mt-2 flex flex-col gap-2 text-base leading-relaxed text-ink-soft md:text-lg md:leading-relaxed">
              {s.paragraphs?.map((p) => (
                <p class="text-pretty">{p}</p>
              ))}
              {s.list && (
                <ul class="flex flex-col gap-1.5 pl-1">
                  {s.list.map((li) => (
                    <li class="flex items-start gap-2 text-pretty">
                      <span aria-hidden="true" class="mt-[0.7em] size-[0.375rem] shrink-0 rounded-full bg-highlight/70" />
                      <span>{li}</span>
                    </li>
                  ))}
                </ul>
              )}
              {s.paragraphs_after?.map((p) => (
                <p class="text-pretty">{p}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</div>
