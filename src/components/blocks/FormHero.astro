---
// Hero for lead-capture pages (demo request, free audit): text left (pinned on lg), the form right in a
// gradient-border panel; phones stack the form directly under the text. No CTA buttons: the form is the action.
// Netlify Forms markup (hidden form-name + honeypot) is built in. Content comes from the page's data file.
import Breadcrumb, { type BreadcrumbItem } from './Breadcrumb.astro';
import Eyebrow from './Eyebrow.astro';
import Field, { type FieldProps } from './form/Field.astro';
import Button from '../Button.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import LineRings from '../ui/LineRings.astro';

export interface FormContent {
  /** Netlify form name */
  name: string;
  /** Success page */
  action: string;
  fields: FieldProps[];
  submit: string;
  note: string;
  /** One line under the form, e.g. pointing another kind of visitor elsewhere */
  /** `external`: opens in a new tab (e.g. the booking page); `newTabLabel` is its screen-reader note */
  footer?: { text: string; link: { label: string; href: string; external?: boolean; newTabLabel?: string } };
}

interface Props {
  breadcrumb: BreadcrumbItem[];
  eyebrow: string;
  h1: string;
  sub: string;
  form: FormContent;
  /** Field names that pair up two per row from sm (the rest run full width) */
  halfWidth?: string[];
}

const { breadcrumb, eyebrow, h1, sub, form, halfWidth = [] } = Astro.props;
const half = new Set(halfWidth);
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden border-b border-line px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pb-16 lg:pt-40"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_60%_60%_at_20%_30%,#000_30%,transparent_100%)]"></div>
    <LineRings
      class="absolute -left-64 top-40 w-[48rem] max-w-none text-highlight opacity-20 [mask-image:radial-gradient(circle_at_60%_40%,#000_30%,transparent_70%)]"
    />
  </div>

  <div class="mx-auto grid w-full max-w-site gap-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-start lg:gap-12">
    <div class="flex flex-col items-start lg:sticky lg:top-40">
      <Breadcrumb items={breadcrumb} class="mb-3" />
      <Eyebrow tone="accent">{eyebrow}</Eyebrow>
      <h1
        id="hero-title"
        class="mt-3 max-w-2xl text-balance font-display text-[clamp(2.5rem,1.5rem+4vw,4.5rem)] font-bold leading-[1.02] tracking-tight text-ink"
      >
        {h1}
      </h1>
      <p class="mt-4 max-w-xl text-pretty text-lead text-ink-soft md:mt-5">{sub}</p>
      <slot />
    </div>

    <div id="form" class="scroll-mt-28 rounded-card bg-gradient-to-br from-accent/50 via-line to-highlight/40 p-px">
      <form
        name={form.name}
        method="POST"
        action={form.action}
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="grid gap-3 rounded-[calc(var(--radius-card)-1px)] bg-surface-raised p-3 sm:grid-cols-2 md:p-5"
      >
        <input type="hidden" name="form-name" value={form.name} />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        {form.fields.map((field) => <Field {...field} class={half.has(field.name) ? '' : 'sm:col-span-2'} />)}

        <div class="flex flex-col gap-2 sm:col-span-2">
          <Button type="submit" variant="primary" size="base" fullWidth>{form.submit}</Button>
          <p class="text-center text-meta text-ink-muted">{form.note}</p>
        </div>

        {
          form.footer && (
            <p class="flex flex-wrap items-center justify-center gap-x-1 border-t border-line pt-3 text-meta text-ink-soft sm:col-span-2">
              {form.footer.text}
              <ArrowLink href={form.footer.link.href} external={form.footer.link.external} newTabLabel={form.footer.link.newTabLabel}>
                {form.footer.link.label}
              </ArrowLink>
            </p>
          )
        }
      </form>
    </div>
  </div>
</section>
