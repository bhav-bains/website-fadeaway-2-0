---
// Decorative hero illustration: a browser with a search bar and an AI answer card citing a business,
// plus floating cards for bookings growth, 5-star reviews and a local map pin.
// No words inside (no invented copy); colors come from theme tokens. Hidden from screen readers.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Five-point star polygon centred on (cx, cy)
const star = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const radius = i % 2 === 0 ? r : r * 0.45;
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + radius * Math.cos(angle)).toFixed(1)},${(cy + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(' ');

const bars = [
  { x: 28, h: 22 },
  { x: 60, h: 34 },
  { x: 92, h: 48 },
  { x: 124, h: 64 },
  { x: 156, h: 84 },
];
const barBase = 418;
const sparkle =
  'M0 -9 L2.2 -2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2 -2.2 Z';
---

<svg
  class={className}
  viewBox="0 0 560 460"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="hero-ill-border" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-accent)" />
      <stop offset="1" style="stop-color: var(--color-highlight)" />
    </linearGradient>
    <linearGradient id="hero-ill-trend" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" style="stop-color: var(--color-highlight)" />
      <stop offset="1" style="stop-color: var(--color-accent)" />
    </linearGradient>
  </defs>

  <!-- Browser window -->
  <rect x="40" y="30" width="440" height="330" rx="20" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
  <circle cx="68" cy="58" r="5" class="fill-white/15" />
  <circle cx="86" cy="58" r="5" class="fill-white/15" />
  <circle cx="104" cy="58" r="5" class="fill-white/15" />
  <rect x="130" y="48" width="250" height="20" rx="10" class="fill-white/5" />
  <line x1="40" y1="80" x2="480" y2="80" class="stroke-line" />

  <!-- Search bar -->
  <rect x="72" y="98" width="376" height="44" rx="22" class="fill-canvas stroke-line-strong" stroke-width="1.5" />
  <circle cx="98" cy="118" r="7" class="stroke-ink-muted" stroke-width="2" />
  <line x1="103" y1="123" x2="109" y2="129" class="stroke-ink-muted" stroke-width="2" stroke-linecap="round" />
  <rect x="120" y="115" width="170" height="10" rx="5" class="fill-white/15" />
  <circle cx="424" cy="120" r="14" class="fill-accent/15" />
  <path d={sparkle} transform="translate(424 120) scale(0.8)" class="fill-accent" />

  <!-- AI answer card citing a business -->
  <rect x="72" y="160" width="376" height="124" rx="16" class="fill-canvas" stroke="url(#hero-ill-border)" stroke-width="1.5" />
  <path d={sparkle} transform="translate(96 184)" class="fill-accent" />
  <rect x="114" y="179" width="92" height="10" rx="5" class="fill-accent/60" />
  <rect x="92" y="204" width="324" height="8" rx="4" class="fill-white/15" />
  <rect x="92" y="220" width="300" height="8" rx="4" class="fill-white/15" />
  <rect x="92" y="236" width="252" height="8" rx="4" class="fill-white/15" />
  <rect x="92" y="254" width="132" height="18" rx="9" class="fill-highlight/15" />
  <circle cx="104" cy="263" r="5" class="fill-highlight" />
  <rect x="115" y="259" width="96" height="8" rx="4" class="fill-highlight/70" />

  <!-- Result lines under the answer -->
  <rect x="72" y="302" width="190" height="10" rx="5" class="fill-white/25" />
  <rect x="72" y="320" width="300" height="8" rx="4" class="fill-white/10" />
  <rect x="72" y="334" width="250" height="8" rx="4" class="fill-white/10" />

  <!-- Floating: bookings growth -->
  <g class="motion-safe:animate-float">
    <rect x="4" y="296" width="206" height="146" rx="16" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
    <rect x="28" y="316" width="70" height="8" rx="4" class="fill-white/25" />
    {
      bars.map((bar, i) => (
        <rect
          x={bar.x}
          y={barBase - bar.h}
          width="22"
          height={bar.h}
          rx="4"
          class={i === bars.length - 1 ? 'fill-highlight' : 'fill-highlight/25'}
        />
      ))
    }
    <polyline
      points={bars.map((bar) => `${bar.x + 11},${barBase - bar.h - 10}`).join(' ')}
      stroke="url(#hero-ill-trend)"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx={bars[4].x + 11} cy={barBase - bars[4].h - 10} r="4.5" class="fill-accent" />
  </g>

  <!-- Floating: 5-star reviews -->
  <g class="motion-safe:animate-float [animation-delay:-2s]">
    <rect x="382" y="318" width="164" height="50" rx="25" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
    {[0, 1, 2, 3, 4].map((i) => <polygon points={star(410 + i * 27, 343, 9)} class="fill-accent" />)}
  </g>

  <!-- Floating: local map pin -->
  <g class="motion-safe:animate-float [animation-delay:-4s]">
    <circle cx="500" cy="64" r="40" class="fill-accent/10" />
    <circle cx="500" cy="64" r="26" class="fill-accent/20" />
    <path
      d="M500 44c-9.4 0-17 7.4-17 16.6C483 73 500 88 500 88s17-15 17-27.4C517 51.4 509.4 44 500 44z"
      class="fill-accent"
    />
    <circle cx="500" cy="60" r="6" class="fill-surface-raised" />
  </g>
</svg>
