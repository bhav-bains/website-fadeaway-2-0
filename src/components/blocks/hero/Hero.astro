---
// Picks a Hero design. Every variant takes the same HeroContent.
import HeroCentered from './HeroCentered.astro';
import HeroSplit from './HeroSplit.astro';
import HeroEditorial from './HeroEditorial.astro';
import HeroVisual from './HeroVisual.astro';
import HeroShowcase from './HeroShowcase.astro';
import HeroStatement from './HeroStatement.astro';
import HeroBlueprint from './HeroBlueprint.astro';
import type { HeroContent, HeroVariant } from './types';

interface Props extends HeroContent {
  variant?: HeroVariant;
}

const { variant = 'centered', ...content } = Astro.props;

const variants = {
  centered: HeroCentered,
  split: HeroSplit,
  editorial: HeroEditorial,
  visual: HeroVisual,
  showcase: HeroShowcase,
  statement: HeroStatement,
  blueprint: HeroBlueprint,
};

const Variant = variants[variant];
---

<Variant {...content} />
