---
// Hero variant F: statement. Oversized left-aligned H1, a hairline rule, then sub-headline and buttons side by side.
// A large faint illustration bleeds off the right edge behind the text. Built for solutions pages.
// Always at least one screen tall (min-h-svh); content is centred vertically in that space.
import clsx from 'clsx';
import Breadcrumb from '../Breadcrumb.astro';
import LogoBand from '../LogoBand.astro';
import HeroActions from './HeroActions.astro';
import HeroIllustration from './HeroIllustration.astro';
import { illustrations } from '../../illustrations';
import type { HeroContent } from './types';

type Props = HeroContent;
const { displayLine, eyebrow, proofLine, h1, sub, primaryCta, secondaryCta, breadcrumb, visual, logos } = Astro.props;
const Visual = visual ? illustrations[visual] : HeroIllustration;

const statementSize = 'text-[clamp(2.75rem,1.25rem+5.5vw,6rem)] leading-[1]';
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-svh flex-col overflow-hidden border-b border-line px-2 pb-6 pt-28 sm:px-3 sm:pt-32 md:pb-10 lg:px-4 lg:pb-16 lg:pt-40"
>
  <!-- Faint illustration bleeding off the right edge -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-20 top-20 -z-10 w-[36rem] max-w-none opacity-20 [mask-image:linear-gradient(to_left,#000_40%,transparent_95%)] sm:w-[48rem] lg:-right-10 lg:top-1/2 lg:w-[64rem] lg:-translate-y-1/2 lg:opacity-25"
  >
    <Visual class="h-auto w-full" />
  </div>

  <div class="mx-auto flex w-full max-w-site flex-1 flex-col justify-center">
    {breadcrumb && <Breadcrumb items={breadcrumb} class="mb-3" />}

    {proofLine && <p class="mb-2 max-w-3xl text-pretty text-meta text-ink-soft">{proofLine}</p>}

    {
      eyebrow && (
        <p class="flex items-center gap-1 text-meta font-medium text-ink-muted">
          <span aria-hidden="true" class="size-1 shrink-0 rounded-full bg-accent" />
          <span class="text-balance">{eyebrow}</span>
        </p>
      )
    }

    {
      displayLine && (
        <p class={clsx('mt-3 max-w-5xl text-balance font-display font-bold tracking-tight text-ink', statementSize)}>
          {displayLine}
        </p>
      )
    }

    <h1
      id="hero-title"
      class={clsx(
        'text-balance font-display',
        displayLine
          ? 'mt-3 max-w-3xl text-title font-semibold text-ink-soft'
          : clsx('mt-3 max-w-5xl font-bold tracking-tight text-ink', statementSize),
      )}
    >
      {h1}
    </h1>

    <div class="mt-5 grid gap-4 border-t border-line pt-4 md:mt-8 md:pt-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
      {sub && <p class="max-w-2xl text-pretty text-lead text-ink-soft">{sub}</p>}
      {(primaryCta || secondaryCta) && <HeroActions primary={primaryCta} secondary={secondaryCta} />}
    </div>
  </div>

  {logos && <LogoBand label={logos.label} groups={logos.groups} class="mx-auto mt-6 w-full max-w-site md:mt-8" />}
</section>
