---
// Hero free-audit box: one "your website" field + button. Submitting (GET) carries the URL to the audit page
// (?website=...), which pre-fills its form so the visitor only adds name, email and business there (same workflow
// as the AuditCta block). Stacks on phones, one row from sm. Semantic tokens only.
import clsx from 'clsx';
import Button from '../../Button.astro';
import type { HeroAuditForm } from './types';

interface Props extends HeroAuditForm {
  align?: 'center' | 'start';
  class?: string;
}

const { action, label, placeholder, button, align = 'start', class: className } = Astro.props;
const fieldId = 'hero-audit-website';
---

<form method="GET" action={action} class={clsx('flex w-full max-w-xl flex-col gap-1', align === 'center' && 'mx-auto', className)}>
  <label for={fieldId} class="text-left text-meta font-medium text-ink-soft">{label}</label>
  <div class="flex flex-col gap-2 sm:flex-row">
    <input
      id={fieldId}
      name="website"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      autocapitalize="off"
      required
      placeholder={placeholder}
      class="min-h-12 w-full min-w-0 flex-1 rounded-control border border-line-strong bg-canvas/60 px-2 py-1.5 text-base text-ink placeholder:text-ink-muted/70 transition-colors hover:border-ink-muted/50 focus:border-highlight focus:outline-none focus-visible:ring-2 focus-visible:ring-highlight/30"
    />
    <Button type="submit" variant="primary" size="base" className="w-full shrink-0 sm:w-auto">{button}</Button>
  </div>
</form>
