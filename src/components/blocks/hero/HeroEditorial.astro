---
// Hero variant C: editorial. Oversized left-aligned display line, then a two-column row:
// H1 + sub + buttons on the left, answer capsule as a pull-out on the right.
import HeroActions from './HeroActions.astro';
import type { HeroContent } from './types';

type Props = HeroContent;
const { displayLine, eyebrow, h1, sub, primaryCta, secondaryCta, answerCapsule } = Astro.props;
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="border-b border-line px-2 pb-6 pt-24 sm:px-3 md:pb-10 md:pt-40 lg:px-4"
>
  <div class="mx-auto max-w-site">
    {
      eyebrow && (
        <p class="flex items-center gap-1 text-meta font-medium text-ink-muted">
          <span aria-hidden="true" class="size-1 shrink-0 rounded-full bg-accent" />
          <span class="text-balance">{eyebrow}</span>
        </p>
      )
    }

    {
      displayLine && (
        <p class="mt-2 max-w-5xl text-balance font-display text-display font-bold tracking-tight text-ink">
          {displayLine}
        </p>
      )
    }

    <div class="mt-4 grid gap-4 border-t border-line pt-4 md:mt-6 md:pt-6 lg:grid-cols-2 lg:gap-10">
      <div class="flex flex-col items-start">
        <h1 id="hero-title" class="text-balance font-display text-title font-semibold text-ink">
          {h1}
        </h1>
        {sub && <p class="mt-2 text-pretty text-lead text-ink-muted">{sub}</p>}
        <HeroActions primary={primaryCta} secondary={secondaryCta} class="mt-4" />
      </div>

      {
        answerCapsule && (
          <p class="border-l-2 border-accent pl-2 text-base text-ink-soft md:pl-3 md:text-lg lg:self-center">
            {answerCapsule}
          </p>
        )
      }
    </div>
  </div>
</section>
