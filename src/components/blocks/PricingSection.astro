---
// Pricing body for the demo-industry pages (Wellness, Boutique Fitness, Sports): the "start with one, never both"
// pair (website setup or Full Audit), the monthly plans under a hairline, fine print, the custom-build fork and
// one closing button. Renders inside a Section that carries the heading and intro.
import PricingCard, { type PricingItem } from './PricingCard.astro';
import ForkCallout from './ForkCallout.astro';
import Button from '../Button.astro';

export interface PricingContent {
  /** Start with one: website setup (featured) or Full Audit */
  start: PricingItem[];
  /** Then a plan */
  plans: PricingItem[];
  finePrint: string;
  custom: { heading: string; text: string; link: { label: string; href: string } };
  cta: { label: string; href: string };
}

type Props = PricingContent;

const { start, plans, finePrint, custom, cta } = Astro.props;
---

<div class="grid gap-3 md:grid-cols-2 md:gap-4">
  {start.map((item) => <PricingCard {...item} />)}
</div>
<div class="mt-4 grid gap-3 border-t border-line pt-4 md:mt-6 md:grid-cols-2 md:gap-4 md:pt-6">
  {plans.map((item) => <PricingCard {...item} />)}
</div>
<p class="mt-3 max-w-4xl text-pretty text-meta text-ink-muted">{finePrint}</p>
<ForkCallout heading={custom.heading} text={custom.text} link={custom.link} class="mt-6 md:mt-8" />
<div class="mt-4 flex md:mt-6">
  <Button href={cta.href} variant="primary" size="base">{cta.label}</Button>
</div>
