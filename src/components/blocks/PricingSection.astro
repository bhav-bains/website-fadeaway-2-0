---
// Pricing body for the demo-industry pages (Wellness, Boutique Fitness, Sports): the two monthly plans as compact,
// expandable cards side by side (stacked on phones, never a swipe row so both are always visible), each with its own
// button, then one quiet line about the one-time setup. Renders inside a Section that carries the heading and intro.
import PricingCard, { type PricingItem } from './PricingCard.astro';

export interface PricingContent {
  plans: PricingItem[];
  /** One quiet line about the one-time setup (website from the demo, or a Full Audit) */
  setupLine: string;
}

type Props = PricingContent;

const { plans, setupLine } = Astro.props;
---

<div class="grid items-start gap-3 md:grid-cols-2 md:gap-4">
  {plans.map((item) => <PricingCard {...item} />)}
</div>
<p class="mt-4 max-w-3xl text-pretty text-base text-ink-soft md:mt-6">{setupLine}</p>
