---
// Time-based expectations: a rail with a marker per phase ("First weeks", "Months 1 to 2"...), the phase label as
// the H3, one paragraph each. lg: horizontal rail across N columns, markers growing as time passes; below lg:
// vertical rail. `swipe`: on phones the phases become a swipeable row of cards (marker on top), back to the rail from md.
// Not a HowTo (these are expectations, not steps).
import clsx from 'clsx';

export interface TimelineItem {
  title: string;
  text: string;
}

interface Props {
  items: TimelineItem[];
  /** Phones: a swipeable scroll-snap row of cards instead of the vertical rail */
  swipe?: boolean;
  class?: string;
}

const { items, swipe = false, class: className } = Astro.props;
const lgColumns = { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5' } as Record<number, string>;
// Marker grows along the rail: time compounding
const marker = ['size-[0.625rem]', 'size-[0.75rem]', 'size-[0.875rem]', 'size-[1rem]', 'size-[1.125rem]'];
---

<ol
  class={clsx(
    'relative',
    swipe
      ? '-mx-2 flex snap-x snap-mandatory scroll-px-2 gap-2 overflow-x-auto px-2 pb-1 no-scrollbar sm:-mx-3 sm:scroll-px-3 sm:px-3 md:mx-0 md:grid md:snap-none md:gap-5 md:overflow-visible md:border-l md:border-line md:px-0 md:pb-0 md:pl-4 lg:gap-6 lg:border-l-0 lg:border-t lg:pl-0 lg:pt-6'
      : 'grid gap-5 border-l border-line pl-4 lg:gap-6 lg:border-l-0 lg:border-t lg:pl-0 lg:pt-6',
    lgColumns[items.length],
    className,
  )}
>
  {
    items.map((item, i) => (
      <li
        class={clsx(
          'relative flex flex-col gap-1',
          swipe && 'max-md:shrink-0 max-md:basis-[80%] max-md:snap-start max-md:rounded-card max-md:border max-md:border-line-strong max-md:bg-surface-lifted max-md:p-3',
        )}
      >
        <span
          aria-hidden="true"
          class={clsx(
            'absolute -left-4 top-2 -translate-x-1/2 rounded-full border border-highlight/60 bg-surface-raised lg:-top-6 lg:left-0 lg:translate-x-0 lg:-translate-y-1/2',
            marker[i] ?? 'size-[1.125rem]',
            swipe && 'max-md:relative max-md:left-0 max-md:top-0 max-md:mb-1 max-md:translate-x-0',
            i === items.length - 1 && 'border-accent bg-accent/30',
          )}
        />
        <h3 class="font-display text-xl font-bold text-ink md:text-2xl">{item.title}</h3>
        <p class="max-w-md text-pretty text-base text-ink-muted">{item.text}</p>
      </li>
    ))
  }
</ol>
