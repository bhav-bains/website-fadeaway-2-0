---
// Numbered process: markers joined by a connector line (accent to highlight), H3 title, one line of prose.
// Phones: vertical timeline. md and up: steps side by side.
// Pair with howToSchema() (src/lib/schema.ts) fed from the same items so the HowTo JSON-LD matches the visible text.
import clsx from 'clsx';

export interface StepItem {
  title: string;
  text: string;
}

interface Props {
  items: StepItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const mdColumns = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' } as Record<number, string>;
---

<ol class={clsx('grid gap-5 md:gap-4', mdColumns[items.length] ?? 'md:grid-cols-3', className)}>
  {
    items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li class="relative grid content-start grid-cols-[auto_minmax(0,1fr)] gap-x-3 md:grid-cols-1 md:gap-y-3">
          {!last && (
            <span
              aria-hidden="true"
              class="absolute left-6 top-12 -bottom-5 w-px bg-gradient-to-b from-accent/60 to-highlight/60 md:left-14 md:right-0 md:top-6 md:bottom-auto md:h-px md:w-auto md:bg-gradient-to-r"
            />
          )}
          <span
            aria-hidden="true"
            class={clsx(
              'relative inline-flex size-12 items-center justify-center rounded-full border bg-surface-raised font-display text-base font-semibold tabular-nums',
              i === 0 ? 'border-accent/50 text-accent shadow-glow-accent' : 'border-highlight/40 text-highlight',
            )}
          >
            {pad(i + 1)}
          </span>
          <div class="flex flex-col gap-1 pb-1 md:pr-3">
            <h3 class="font-display text-xl font-bold text-ink md:text-2xl">{item.title}</h3>
            <p class="max-w-md text-pretty text-base text-ink-muted">{item.text}</p>
          </div>
        </li>
      );
    })
  }
</ol>
