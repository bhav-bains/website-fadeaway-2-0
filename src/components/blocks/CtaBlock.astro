---
// Call-to-action panel: heading, one line, one button (optional second button beside it). Gradient border (accent to highlight), oversized line art, no glow.
// layout "split" (inline call-outs): stacked on phones, text left and button right from md.
// layout "center" (closing CTA): larger type, everything centred.
import clsx from 'clsx';
import Button from '../Button.astro';
import ArrowLink from '../ui/ArrowLink.astro';

interface Props {
  heading: string;
  text?: string;
  /** Optional bookend line in large display type above the button (center layout), e.g. a brand slogan */
  signoff?: string;
  cta: { label: string; href: string };
  /** Optional second button (secondary style) beside the first */
  secondaryCta?: { label: string; href: string };
  /** Optional lower-commitment link under the button (center layout) */
  link?: { label: string; href: string };
  /** h3 inside a titled section; h2 when the CTA is the section's own heading */
  headingAs?: 'h2' | 'h3';
  headingId?: string;
  layout?: 'split' | 'center';
  class?: string;
}

const {
  heading,
  text,
  cta,
  secondaryCta,
  link,
  signoff,
  headingAs: Heading = 'h3',
  headingId,
  layout = 'split',
  class: className,
} = Astro.props;
const center = layout === 'center';
---

<div class={clsx('rounded-card bg-gradient-to-br from-accent/50 via-line to-highlight/50 p-px', className)}>
  <div
    class={clsx(
      'relative isolate flex flex-col overflow-hidden rounded-[calc(var(--radius-card)-1px)] bg-surface-raised',
      center
        ? 'items-center gap-4 px-3 py-6 text-center md:px-6 md:py-10'
        : 'gap-3 p-3 md:flex-row md:items-center md:justify-between md:gap-6 md:p-5',
    )}
  >
    {/* Oversized line art (no glow): a forward arrow breaking out of concentric rings, bleeding off the right edge */}
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 320 320"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={clsx(
        'pointer-events-none absolute -z-10 text-accent opacity-25 [mask-image:radial-gradient(circle_at_50%_50%,#000_35%,transparent_75%)]',
        center ? '-bottom-24 -right-20 size-[22rem] md:size-[30rem]' : '-bottom-20 -right-16 size-[18rem] md:size-[22rem]',
      )}
    >
      <circle cx="160" cy="160" r="60" opacity=".6" />
      <circle cx="160" cy="160" r="96" opacity=".35" />
      <circle cx="160" cy="160" r="132" opacity=".18" />
      <path d="M104 216L250 70" />
      <path d="M180 70h70v70" />
      <path d="M128 70h24M250 192v-24" opacity=".5" />
    </svg>
    {
      center && (
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_60%_70%_at_50%_50%,#000_20%,transparent_100%)]"
        />
      )
    }
    <div class={clsx('flex flex-col', center ? 'items-center gap-2' : 'gap-1')}>
      <Heading
        id={headingId}
        class={clsx(
          'text-balance font-display font-bold text-ink',
          center ? 'text-heading' : 'text-2xl md:text-3xl',
        )}
      >
        {heading}
      </Heading>
      {text && <p class="max-w-2xl text-pretty text-base text-ink-soft md:text-lg">{text}</p>}
    </div>
    {signoff && <p class="font-display text-3xl font-bold tracking-tight text-accent md:text-4xl">{signoff}</p>}
    {
      secondaryCta ? (
        <div class={clsx('flex shrink-0 flex-wrap gap-2', center ? 'justify-center' : 'self-start md:self-auto')}>
          <Button href={cta.href} variant="primary" size="base">
            {cta.label}
          </Button>
          <Button href={secondaryCta.href} variant="secondary" size="base">
            {secondaryCta.label}
          </Button>
        </div>
      ) : (
        <Button
          href={cta.href}
          variant="primary"
          size="base"
          className={clsx('shrink-0', center ? '' : 'self-start md:self-auto')}
        >
          {cta.label}
        </Button>
      )
    }
    {link && <ArrowLink href={link.href}>{link.label}</ArrowLink>}
  </div>
</div>
