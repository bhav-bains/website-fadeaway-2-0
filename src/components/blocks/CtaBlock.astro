---
// Call-to-action panel: heading, one line, one button. Gradient border (accent to highlight).
// layout "split" (inline call-outs): stacked on phones, text left and button right from md.
// layout "center" (closing CTA): larger type, everything centred.
import clsx from 'clsx';
import Button from '../Button.astro';

interface Props {
  heading: string;
  text: string;
  cta: { label: string; href: string };
  /** h3 inside a titled section; h2 when the CTA is the section's own heading */
  headingAs?: 'h2' | 'h3';
  headingId?: string;
  layout?: 'split' | 'center';
  class?: string;
}

const {
  heading,
  text,
  cta,
  headingAs: Heading = 'h3',
  headingId,
  layout = 'split',
  class: className,
} = Astro.props;
const center = layout === 'center';
---

<div class={clsx('rounded-card bg-gradient-to-br from-accent/50 via-line to-highlight/50 p-px shadow-glow-accent', className)}>
  <div
    class={clsx(
      'relative isolate flex flex-col overflow-hidden rounded-[calc(var(--radius-card)-1px)] bg-surface-raised',
      center
        ? 'items-center gap-4 px-3 py-6 text-center md:px-6 md:py-10'
        : 'gap-3 p-3 md:flex-row md:items-center md:justify-between md:gap-6 md:p-5',
    )}
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-10 -top-10 -z-10 size-[16rem] rounded-full bg-accent/10 blur-lg"
    >
    </div>
    {
      center && (
        <>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 -left-10 -z-10 size-[16rem] rounded-full bg-highlight/10 blur-lg"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 bg-grid [mask-image:radial-gradient(ellipse_60%_70%_at_50%_50%,#000_20%,transparent_100%)]"
          />
        </>
      )
    }
    <div class={clsx('flex flex-col', center ? 'items-center gap-2' : 'gap-1')}>
      <Heading
        id={headingId}
        class={clsx(
          'text-balance font-display font-bold text-ink',
          center ? 'text-heading' : 'text-2xl md:text-3xl',
        )}
      >
        {heading}
      </Heading>
      <p class="max-w-2xl text-pretty text-base text-ink-soft md:text-lg">{text}</p>
    </div>
    <Button
      href={cta.href}
      variant="primary"
      size="base"
      className={clsx('shrink-0', center ? '' : 'self-start md:self-auto')}
    >
      {cta.label}
    </Button>
  </div>
</div>
