---
// Shell for every page section: anchor id, optional eyebrow / H2 / intro, background tone, optional separator,
// content width and responsive spacing. Blocks (CardGrid, IconGrid, NumberedList...) render inside it.
// Layouts:
//   stack (default): header above the content
//   split: header in a left column (pinned while scrolling on lg), content on the right; stacked on phones
// Optional "actions" slot: links or buttons under the intro, inside the header.
// Optional `lead`: a standfirst paragraph above the header (e.g. a page's answer capsule in the first section after the Hero).
// Mobile-first: unprefixed classes are the phone layout; sm/md/lg scale up.
import clsx from 'clsx';
import Eyebrow from './Eyebrow.astro';

interface Props {
  /** Anchor id from the copy file, e.g. "how-it-works" */
  id: string;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  /** Standfirst above the header: real text with a thin accent rule, quieter than the heading */
  lead?: string;
  layout?: 'stack' | 'split';
  tone?: 'canvas' | 'alt' | 'surface' | 'deep';
  width?: 'site' | 'narrow' | 'prose';
  /** Header alignment in the stack layout (split is always left-aligned) */
  align?: 'center' | 'start';
  /** Faint hairline at the top edge (fades out at both ends): use only between major sections. Sections otherwise share one background. */
  separator?: boolean;
  /** Id of a heading rendered inside the content (use when the section has no `heading` of its own) */
  labelledBy?: string;
  class?: string;
}

const {
  id,
  eyebrow,
  heading,
  intro,
  layout = 'stack',
  tone = 'canvas',
  width = 'site',
  align = 'center',
  separator = false,
  labelledBy,
  lead,
  class: className,
} = Astro.props;

const headingId = heading ? `${id}-heading` : undefined;
const split = layout === 'split';
const centered = !split && align === 'center';

const tones = {
  canvas: 'bg-canvas',
  alt: 'bg-surface-alt',
  surface: 'bg-surface',
  deep: 'bg-surface-deep',
};

const widths = {
  site: 'max-w-site',
  narrow: 'max-w-5xl',
  prose: 'max-w-3xl',
};

const hasHeader = eyebrow || heading || intro;

// Keep hyphenated words ("E-commerce") on one line; the text itself is unchanged
const headingParts = heading ? heading.split(/(\S+-\S+)/) : [];
---

<section
  id={id}
  aria-labelledby={headingId ?? labelledBy}
  class={clsx('relative isolate px-2 py-6 sm:px-3 md:py-10 lg:px-4 lg:py-24', tones[tone], className)}
>
  {
    separator && (
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 flex justify-center">
        <span class="h-px w-full max-w-4xl bg-gradient-to-r from-transparent via-highlight/25 to-transparent" />
      </div>
    )
  }
  <div
    class={clsx(
      'mx-auto w-full',
      widths[width],
      split && 'grid gap-4 md:gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12',
    )}
  >
    {
      lead && (
        <p
          class={clsx(
            'mx-auto max-w-3xl text-pretty border-l-2 border-accent/70 pl-2 text-left text-base text-ink-muted md:pl-3 md:text-lg',
            split ? 'lg:col-span-2' : 'mb-6 md:mb-10',
          )}
        >
          {lead}
        </p>
      )
    }
    {
      hasHeader && (
        <header
          class={clsx(
            'flex flex-col gap-2',
            centered ? 'items-center text-center' : 'items-start text-left',
            split ? 'lg:sticky lg:top-32 lg:self-start' : 'mb-4 md:mb-6',
          )}
        >
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          {heading && (
            <h2 id={headingId} class="max-w-3xl text-balance font-display text-heading font-bold text-ink">
              {headingParts.map((part, i) => (i % 2 === 1 ? <span class="whitespace-nowrap">{part}</span> : part))}
            </h2>
          )}
          {intro && <p class="max-w-2xl text-pretty text-base text-ink-soft md:text-lg">{intro}</p>}
          {Astro.slots.has('actions') && (
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
              <slot name="actions" />
            </div>
          )}
        </header>
      )
    }
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
