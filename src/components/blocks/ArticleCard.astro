---
// One article card: image (line art by topic when the article has none), topic chip, title, description, reading time,
// and "Read the article". The whole card is the link (stretched link). `feature`: one wide card (image left on md),
// for the newest article on /articles/. Rendered as an <li>: use inside a <ul> grid (ArticleGrid).
import { Image } from 'astro:assets';
import clsx from 'clsx';
import { illustrations } from '../illustrations';
import { articleHref, articleArt, readingMinutes, type Article } from '../../lib/articles';
import { cardLinkLabel, minReadLabel } from '../../data/pages/articles';
import { visibleTags } from '../../data/tags';

interface Props {
  entry: Article;
  headingAs?: 'h2' | 'h3';
  feature?: boolean;
}

const { entry, headingAs: Title = 'h3', feature = false } = Astro.props;
const { data } = entry;
const topic = visibleTags(data.tags)[0];
const Art = illustrations[articleArt(entry)];
---

<li
  class={clsx(
    'group relative flex flex-col overflow-hidden rounded-card border border-line-strong bg-surface-lifted transition-colors duration-300 hover:border-highlight/40 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-highlight',
    feature && 'md:grid md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]',
  )}
>
  <div class={clsx('relative overflow-hidden border-b border-line bg-surface-alt/60', feature && 'md:border-b-0 md:border-r')}>
    {
      data.image ? (
        <Image
          src={data.image}
          alt={data.imageAlt ?? ''}
          widths={[400, 640, 960, 1280]}
          sizes={feature ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'}
          class={clsx(
            'aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.02] motion-reduce:transition-none',
            feature && 'md:h-full',
          )}
        />
      ) : (
        <div class={clsx('relative aspect-[16/10] w-full px-4 pt-4', feature && 'md:h-full')}>
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_70%_at_50%_40%,#000_30%,transparent_100%)]"
          />
          <Art class="relative mx-auto size-full max-w-md transition-transform duration-500 group-hover:-translate-y-1" />
        </div>
      )
    }
  </div>
  <div class={clsx('flex flex-1 flex-col gap-2 p-3 md:p-4', feature && 'lg:justify-center lg:p-6')}>
    {data.draft && <p class="self-start rounded-pill bg-accent px-2 py-1 text-xs font-semibold text-accent-ink">Draft</p>}
    {topic && <p class="self-start rounded-pill border border-line-strong px-1.5 py-0.5 text-xs font-medium text-ink-muted">{topic.label}</p>}
    <Title class={clsx('text-balance font-display font-bold text-ink', feature ? 'text-xl lg:text-3xl' : 'text-xl')}>
      {data.title}
    </Title>
    <p class={clsx('text-pretty text-ink-muted', feature ? 'text-base' : 'text-sm')}>{data.description}</p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-1 pt-1">
      <a
        href={articleHref(entry)}
        class="inline-flex items-center gap-1 font-semibold text-highlight after:absolute after:inset-0 focus-visible:outline-none"
      >
        {cardLinkLabel}
        <span class="sr-only">: {data.title}</span>
        <svg
          class="size-icon-sm transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
      <p class="text-meta text-ink-muted">{readingMinutes(entry)} {minReadLabel}</p>
    </div>
  </div>
</li>
