---
// The page's main conversion panel: the free demo offer. Heading + offer line + three numbered mini steps on the
// left; on the right a line drawing of a demo site being reviewed (browser frame, a private-link chip, a cursor on
// "approve") above the primary button and a fallback link. Gradient border, no glow. Phones: stacked.
// Heading is the Section's H2 (pass `headingId` for aria-labelledby).
import Button from '../Button.astro';
import ArrowLink from '../ui/ArrowLink.astro';

export interface DemoOfferStep {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  headingId: string;
  text: string;
  steps: DemoOfferStep[];
  cta: { label: string; href: string };
  fallback?: { text: string; link: { label: string; href: string } };
}

const { heading, headingId, text, steps, cta, fallback } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="rounded-card bg-gradient-to-br from-accent/60 via-line to-highlight/50 p-px">
  <div
    class="relative isolate grid gap-6 overflow-hidden rounded-[calc(var(--radius-card)-1px)] bg-surface-raised p-3 md:p-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-12 lg:p-10"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-60 [mask-image:radial-gradient(ellipse_60%_80%_at_85%_50%,#000_20%,transparent_100%)]"></div>

    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <h2 id={headingId} class="text-balance font-display text-heading font-bold text-ink">{heading}</h2>
        <p class="max-w-2xl text-pretty text-base text-ink-soft md:text-lg">{text}</p>
      </div>
      <ol class="grid gap-3 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="flex flex-col gap-1 border-t border-line pt-2">
              <span aria-hidden="true" class="font-display text-meta font-semibold tabular-nums text-highlight">
                {pad(i + 1)}
              </span>
              <h3 class="font-display text-lg font-bold text-ink">{step.title}</h3>
              <p class="text-pretty text-meta text-ink-muted md:text-base">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="flex flex-col items-start gap-3 lg:items-stretch">
      {/* A demo site arriving for review: browser frame, private-link chip, cursor on "approve" */}
      <svg
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 320 200"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden w-full max-w-sm text-ink-soft lg:block"
      >
        <rect x="20" y="16" width="240" height="160" rx="10" opacity=".7" />
        <path d="M20 40h240" opacity=".5" />
        <circle cx="34" cy="28" r="3" opacity=".6" />
        <circle cx="45" cy="28" r="3" opacity=".6" />
        <rect x="40" y="56" width="110" height="12" rx="3" opacity=".7" />
        <path d="M40 80h140M40 92h110" opacity=".45" />
        <rect x="40" y="108" width="60" height="18" rx="9" class="text-accent" />
        <rect x="170" y="56" width="70" height="70" rx="6" opacity=".45" />
        <path d="M40 146h60M110 146h60M180 146h60" opacity=".35" />
        <rect x="200" y="150" width="104" height="34" rx="8" class="fill-surface-raised text-highlight" />
        <path d="M214 167h10M219 162l5 5-5 5" class="text-highlight" />
        <path d="M234 162h50M234 172h32" class="text-highlight" opacity=".6" />
        <path d="M86 118v24l6 -6 5 11 5 -2 -5 -11h9z" class="fill-surface-raised text-ink" />
      </svg>
      <Button href={cta.href} variant="primary" size="base" className="w-full sm:w-auto lg:w-full">{cta.label}</Button>
      {
        fallback && (
          <p class="flex flex-wrap items-center gap-x-1 text-meta text-ink-muted">
            {fallback.text}
            <ArrowLink href={fallback.link.href}>{fallback.link.label}</ArrowLink>
          </p>
        )
      }
    </div>
  </div>
</div>
