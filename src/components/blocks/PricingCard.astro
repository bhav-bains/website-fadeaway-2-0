---
// One priced plan, compact: name, price + cadence, who it's for, a native <details> that opens to the full
// deliverables list and the outcome line (all of it is in the HTML), and the standard outlined button at the bottom, so
// the button moves down when the card opens. `tone` colours the card: `accent` (orange) or `highlight` (green).
// Cards sit side by side from md up (the grid uses items-start so opening one doesn't stretch its neighbour) and
// stack on phones.
import clsx from 'clsx';
import Button from '../Button.astro';

export interface PricingItem {
  name: string;
  price: string;
  /** e.g. "/ month", "one time" */
  cadence: string;
  /** Who it's for (one sentence) */
  for: string;
  /** Optional context paragraph under "for" */
  note?: string;
  includedLabel: string;
  included: string[];
  outcomeLabel: string;
  outcome: string;
  /** Card colour: accent (orange) or highlight (green) */
  tone?: 'accent' | 'highlight';
  /** Button at the bottom of the card (e.g. start the conversation on the contact page) */
  cta?: { label: string; href: string };
}

interface Props extends PricingItem {
  /** Label on the expander */
  detailsLabel: string;
  class?: string;
}

const { name, price, cadence, for: forWho, note, included, outcomeLabel, outcome, tone = 'accent', cta, detailsLabel, class: className } =
  Astro.props;

const toneStyles = {
  accent: { border: 'bg-gradient-to-br from-accent/70 via-accent/20 to-line', tick: 'text-accent', bar: 'border-accent/60', button: '' },
  highlight: { border: 'bg-gradient-to-br from-highlight/70 via-highlight/20 to-line', tick: 'text-highlight', bar: 'border-highlight/60', button: '!border-highlight !text-highlight hover:!bg-highlight/10 focus-visible:!ring-highlight/50' },
}[tone];
---

<article class={clsx('rounded-card p-px', toneStyles.border, className)}>
  <div class="flex flex-col gap-3 rounded-[calc(var(--radius-card)-1px)] bg-surface-lifted p-3 md:p-4 lg:p-5">
    <header class="flex flex-col gap-2">
      <h3 class="font-display text-xl font-bold text-ink md:text-2xl">{name}</h3>
      <p class="flex items-baseline gap-1">
        <span class="font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">{price}</span>
        <span class="text-base text-ink-muted">{cadence}</span>
      </p>
      <p class="text-pretty text-base text-ink-soft">{forWho}</p>
      {note && <p class="text-pretty text-meta text-ink-muted">{note}</p>}
    </header>

    <details class="group/plan border-t border-line">
      <summary
        class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-2 py-1 font-semibold text-ink marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight [&::-webkit-details-marker]:hidden"
      >
        <span>{detailsLabel}</span>
        <svg
          aria-hidden="true"
          class={clsx('size-icon-sm shrink-0 transition-transform duration-300 group-open/plan:rotate-180', toneStyles.tick)}
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m4 6 4 4 4-4" />
        </svg>
      </summary>
      <div class="flex flex-col gap-3 pt-1">
        <ul class="flex flex-col gap-1.5">
          {
            included.map((line) => (
              <li class="flex items-start gap-1.5 text-base text-ink-soft">
                <svg
                  aria-hidden="true"
                  class={clsx('mt-1 size-icon-sm shrink-0', toneStyles.tick)}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m3.5 8.5 3 3 6-7" />
                </svg>
                <span class="text-pretty">{line}</span>
              </li>
            ))
          }
        </ul>
        <div class={clsx('rounded-control border-l-2 bg-canvas/50 p-2 md:p-3', toneStyles.bar)}>
          <p class="text-pretty text-base text-ink-soft">
            <strong class="font-semibold text-ink">{outcomeLabel}</strong>
            {' '}{outcome}
          </p>
        </div>
      </div>
    </details>

    {cta && <Button href={cta.href} variant="secondary" size="base" className={clsx('w-full', toneStyles.button)}>{cta.label}</Button>}
  </div>
</article>
