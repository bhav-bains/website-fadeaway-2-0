---
// Small labelled index of page links: hairline rows, title + one line, arrow that slides on hover.
// For "where next" lists (404, thank-you pages). Renders a <nav> with its own heading.
import clsx from 'clsx';

export interface LinkIndexItem {
  label: string;
  text?: string;
  href: string;
}

interface Props {
  heading: string;
  /** Unique id for the heading (aria-labelledby) */
  id: string;
  links: LinkIndexItem[];
  class?: string;
}

const { heading, id, links, class: className } = Astro.props;
---

<nav aria-labelledby={id} class={className}>
  <h2 id={id} class="text-pretty text-base font-semibold text-ink-soft">{heading}</h2>
  <ul class="mt-2 border-b border-line">
    {
      links.map((link) => (
        <li class="border-t border-line">
          <a
            href={link.href}
            class="group flex items-center justify-between gap-3 py-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight/50 md:py-3"
          >
            <span class="flex flex-col">
              <span class="font-display text-xl font-bold text-ink transition-colors group-hover:text-highlight">{link.label}</span>
              {link.text && <span class="text-meta text-ink-muted">{link.text}</span>}
            </span>
            <svg
              class={clsx(
                'size-icon shrink-0 text-ink-muted transition-[color,transform] duration-300 group-hover:translate-x-1 group-hover:text-highlight',
              )}
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
