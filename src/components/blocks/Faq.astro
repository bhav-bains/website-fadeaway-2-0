---
// FAQ accordion built on native <details>: every answer is in the raw HTML (no JS needed, crawler-readable).
// Feed faqSchema() (src/lib/schema.ts) the same `faq` array so the FAQPage JSON-LD matches word for word.
import clsx from 'clsx';

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faq: FaqItem[];
  class?: string;
}

const { faq, class: className } = Astro.props;
---

<div class={clsx('border-b border-line', className)}>
  {
    faq.map((item) => (
      <details class="group border-t border-line">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-3 py-3 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight/50 md:py-4 [&::-webkit-details-marker]:hidden">
          <h3 class="font-display text-lg font-semibold text-ink transition-colors group-hover:text-highlight md:text-xl">
            {item.q}
          </h3>
          <span
            aria-hidden="true"
            class="inline-flex size-4 shrink-0 items-center justify-center rounded-full border border-line-strong text-highlight transition-transform duration-300 group-open:rotate-45 group-open:border-highlight/40"
          >
            <svg class="size-icon-sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" d="M8 3v10M3 8h10" />
            </svg>
          </span>
        </summary>
        <p class="max-w-3xl pb-4 pr-6 text-pretty text-base text-ink-muted md:pr-10">{item.a}</p>
      </details>
    ))
  }
</div>
