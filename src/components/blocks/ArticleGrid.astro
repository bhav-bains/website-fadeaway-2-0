---
// Article cards in a grid: 3 across on desktop, 2 on tablet, 1 on mobile. `featureFirst`: the first (newest) article
// renders as one wide feature card above the rest (the /articles/ listing). Renders nothing when there are none.
import clsx from 'clsx';
import ArticleCard from './ArticleCard.astro';
import type { Article } from '../../lib/articles';

interface Props {
  entries: Article[];
  featureFirst?: boolean;
  headingAs?: 'h2' | 'h3';
  class?: string;
}

const { entries, featureFirst = false, headingAs = 'h3', class: className } = Astro.props;
const [first, ...rest] = entries;
const grid = featureFirst ? rest : entries;
---

{
  entries.length > 0 && (
    <div class={clsx('flex flex-col gap-3 lg:gap-4', className)}>
      {featureFirst && first && (
        <ul>
          <ArticleCard entry={first} headingAs={headingAs} feature />
        </ul>
      )}
      {grid.length > 0 && (
        <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
          {grid.map((entry) => (
            <ArticleCard entry={entry} headingAs={headingAs} />
          ))}
        </ul>
      )}
    </div>
  )
}
