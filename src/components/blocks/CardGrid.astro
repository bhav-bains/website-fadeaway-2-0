---
// Grid of content cards: optional illustration, H3 title, real prose, one link.
// The whole card is clickable (stretched link) but only the link is announced.
// Mobile-first: 1 column, then `columns` from md.
import clsx from 'clsx';
import { illustrations, type IllustrationName } from '../illustrations';

export interface CardGridItem {
  title: string;
  body: string;
  link?: { label: string; href: string };
  illustration?: IllustrationName;
}

interface Props {
  items: CardGridItem[];
  columns?: 2 | 3;
  class?: string;
}

const { items, columns = 2, class: className } = Astro.props;

const mdColumns = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3' };
---

<ul class={clsx('grid gap-3 lg:gap-4', mdColumns[columns], className)}>
  {
    items.map((item) => {
      const Visual = item.illustration ? illustrations[item.illustration] : null;
      return (
        <li class="group relative flex flex-col overflow-hidden rounded-card border border-line-strong bg-surface-raised/60 transition-colors duration-300 hover:border-highlight/40 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-highlight">
          {Visual && (
            <div class="relative border-b border-line bg-canvas/60 px-3 pt-3 md:px-4 md:pt-4">
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_70%_at_50%_40%,#000_30%,transparent_100%)]"
              />
              <Visual class="relative mx-auto h-auto w-full max-w-md transition-transform duration-500 group-hover:-translate-y-1" />
            </div>
          )}

          <div class="flex flex-1 flex-col gap-2 p-3 md:p-4">
            <h3 class="font-display text-xl font-bold text-ink md:text-2xl">{item.title}</h3>
            <p class="text-pretty text-base text-ink-muted">{item.body}</p>
            {item.link && (
              <a
                href={item.link.href}
                class="mt-auto inline-flex items-center gap-1 pt-1 font-semibold text-highlight after:absolute after:inset-0 focus-visible:outline-none"
              >
                {item.link.label}
                <svg
                  class="size-icon-sm transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
