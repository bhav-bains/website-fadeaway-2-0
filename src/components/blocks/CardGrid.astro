---
// Grid of content cards: optional illustration (in a fixed 5:3 frame), H3 title, real prose, one link.
// The whole card is clickable (stretched link) but only the link is announced.
// Mobile-first: 1 column, then `columns` from md.
// `cta`: a last call-out tile (no illustration, accent outline, whole tile clickable). `swipe`: a swipeable row below md (scroll-snap, next card peeks in). `balanced`: 5 items as 3 + 2 on lg (6-column grid, the 2 centred at the same width as the 3). `compact`: small tiles for a list of types (illustration + title, the body is not shown; 3 across from md, 6 on lg, swipe tiles ~half width).
import clsx from 'clsx';
import CalloutCard from './CalloutCard.astro';
import { illustrations, type IllustrationName } from '../illustrations';

export interface CardGridItem {
  title: string;
  body?: string;
  link?: { label: string; href: string };
  illustration?: IllustrationName;
  /** Oversized line art bleeding off the bottom right, behind the text (for text-only cards that need some character) */
  backdrop?: IllustrationName;
}

interface Props {
  items: CardGridItem[];
  columns?: 2 | 3;
  swipe?: boolean;
  cta?: { title: string; body: string; label: string; href: string };
  balanced?: boolean;
  compact?: boolean;
  /** With `swipe` + `cta`: show the call-out card under the row on phones (default). false: the page places it elsewhere. */
  ctaOnPhones?: boolean;
  class?: string;
}

const { items, columns = 2, swipe = false, cta, balanced = false, compact = false, ctaOnPhones = true, phoneGrid = false, class: className } = Astro.props;

// Compact tiles: one row on lg for 4 to 6 tiles (the call-out counts as one), 2 or 3 across below
const tileCount = items.length + (cta ? 1 : 0);
const compactColumns =
  ({ 4: 'md:grid-cols-2 lg:grid-cols-4', 5: 'md:grid-cols-3 lg:grid-cols-5', 6: 'md:grid-cols-3 lg:grid-cols-6' } as Record<number, string>)[tileCount] ??
  'md:grid-cols-3 lg:grid-cols-6';

const mdColumns = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3' };
---

<ul
  class={clsx(
    swipe && phoneGrid
      ? clsx('grid grid-cols-2 gap-2 md:gap-3 lg:gap-4', items.length === 3 && 'max-md:[&>li:nth-child(3)]:col-span-2')
      : swipe
        ? '-mx-2 flex snap-x snap-mandatory scroll-px-2 gap-2 overflow-x-auto px-2 pb-1 no-scrollbar sm:-mx-3 sm:scroll-px-3 sm:px-3 md:mx-0 md:grid md:snap-none md:gap-3 md:overflow-visible md:px-0 md:pb-0 lg:gap-4 [&>li]:shrink-0 [&>li]:snap-start md:[&>li]:basis-auto'
        : 'grid gap-3 lg:gap-4',
    swipe && !phoneGrid && (compact ? '[&>li]:basis-[46%] sm:[&>li]:basis-[34%]' : '[&>li]:basis-[82%] sm:[&>li]:basis-[55%]'),
    compact ? compactColumns : balanced ? 'md:grid-cols-2 lg:grid-cols-6 lg:[&>li]:col-span-2 lg:[&>li:nth-child(4)]:col-start-2 lg:[&>li:nth-child(5)]:col-start-4' : mdColumns[columns],
    className,
  )}
>
  {
    items.map((item) => {
      const Visual = item.illustration ? illustrations[item.illustration] : null;
      const Backdrop = item.backdrop ? illustrations[item.backdrop] : null;
      return (
        <li class="group relative flex flex-col overflow-hidden rounded-card border border-line-strong bg-surface-lifted transition-colors duration-300 hover:border-highlight/40 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-highlight">
          {Backdrop && (
            <Backdrop
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-12 -right-10 w-56 text-highlight opacity-25 transition-transform duration-500 [mask-image:radial-gradient(circle_at_65%_60%,#000_30%,transparent_75%)] group-hover:-translate-y-1 md:w-64"
            />
          )}
          {Visual && (
            <div class={clsx('relative border-b border-line bg-surface-alt/60', compact ? 'px-2 pt-2' : 'px-3 pt-3 md:px-4 md:pt-4')}>
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_70%_at_50%_40%,#000_30%,transparent_100%)]"
              />
              {/* Fixed 5:3 frame, so illustrations with different proportions (Growth is taller) never change the card's image height */}
              <div class="relative mx-auto aspect-[5/3] w-full max-w-md">
                <Visual class="size-full transition-transform duration-500 group-hover:-translate-y-1" />
              </div>
            </div>
          )}

          <div class={clsx('relative flex flex-1 flex-col gap-2', compact ? 'p-2 md:p-3' : 'p-3 md:p-4')}>
            <h3 class={clsx('font-display font-bold text-ink', compact ? 'text-lg md:text-xl' : 'text-xl md:text-2xl')}>{compact ? item.title.split(' Studios').map((part, i) => (i === 0 ? part : <><br />Studios</>)) : item.title}</h3>
            {item.body && <p class="text-pretty text-base text-ink-muted">{item.body}</p>}
            {item.link && (
              <a
                href={item.link.href}
                class="mt-auto inline-flex items-center gap-1 pt-1 font-semibold text-highlight after:absolute after:inset-0 focus-visible:outline-none"
              >
                {item.link.label}
                <svg
                  class="size-icon-sm transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
            )}
          </div>
        </li>
      );
    })
  }
  {
    cta && (
      <li class={clsx('group relative flex flex-col justify-center gap-2 overflow-hidden rounded-card border border-accent/50 bg-surface-lifted p-3 transition-colors duration-300 hover:border-accent has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-highlight', compact ? 'md:p-3' : 'md:p-4', swipe && 'max-md:hidden')}>
        <h3 class={clsx('font-display font-bold text-ink', compact ? 'text-lg md:text-xl' : 'text-xl md:text-2xl')}>{cta.title}</h3>
        <p class={clsx('text-pretty text-ink-muted', compact ? 'text-meta' : 'text-base')}>{cta.body}</p>
        <a
          href={cta.href}
          class="inline-flex items-center gap-1 pt-1 font-semibold text-highlight after:absolute after:inset-0 focus-visible:outline-none"
        >
          {cta.label}
          <svg class="size-icon-sm transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </li>
    )
  }
</ul>
{swipe && cta && ctaOnPhones && <CalloutCard {...cta} class="mt-3 md:hidden" />}
