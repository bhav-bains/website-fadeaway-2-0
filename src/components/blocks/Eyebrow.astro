---
// Small label above a headline.
// A tinted pill at every size (founder, Oct 7: the plain 12px phone text was too small). 14px on phones, 16px from sm;
// long labels wrap inside the pill, centred.
import clsx from 'clsx';

interface Props {
  tone?: 'highlight' | 'accent';
  class?: string;
}

const { tone = 'highlight', class: className } = Astro.props;

const tones = {
  highlight: 'border-highlight/30 bg-highlight/10 text-highlight',
  accent: 'border-accent/30 bg-accent/10 text-accent',
};
---

<p
  class={clsx(
    'inline-block max-w-full text-balance rounded-pill border px-2 py-1 text-center text-meta font-medium sm:text-sm',
    tones[tone],
    className,
  )}
>
  <slot />
</p>
