---
// "What we run" line art: a reporting dashboard. A bar chart, a trend line, a gauge, and a list of channels with
// status ticks, tied together in one frame. Line only, currentColor, decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 320 320"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <rect x="34" y="50" width="252" height="220" rx="12" />
  <path d="M34 76h252" opacity=".5" />
  <circle cx="50" cy="63" r="3" opacity=".6" />
  <circle cx="62" cy="63" r="3" opacity=".6" />
  <!-- Bars -->
  <path d="M58 170v-30M78 170v-44M98 170v-36M118 170v-58M138 170v-70" stroke-width="6" opacity=".45" />
  <path d="M50 170h100" opacity=".4" />
  <!-- Trend line -->
  <path d="M58 136l20 -12 20 6 20 -22 20 -14" opacity=".9" />
  <!-- Gauge -->
  <path d="M176 160a46 46 0 0 1 92 0" opacity=".7" />
  <path d="M222 160l24 -26" />
  <circle cx="222" cy="160" r="4" />
  <path d="M182 160h-6M268 160h-6M222 120v-6" opacity=".5" />
  <!-- Channel list with ticks -->
  <g opacity=".6">
    <path d="M58 200l4 4 8 -9M80 200h86" />
    <path d="M58 222l4 4 8 -9M80 222h70" />
    <path d="M58 244l4 4 8 -9M80 244h96" />
  </g>
  <rect x="190" y="194" width="78" height="56" rx="6" opacity=".45" />
  <path d="M200 236l14 -12 12 8 16 -18 16 10" opacity=".6" />
  <circle cx="160" cy="160" r="150" opacity=".1" />
</svg>
