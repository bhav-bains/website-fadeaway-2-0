  <circle cx="200" cy="118" r="92" class="stroke-line-strong" stroke-dasharray="3 6" />
  <rect x="180" y="30" width="40" height="16" rx="6" class="stroke-highlight" />
  <rect x="178" y="52" width="44" height="16" rx="6" class="stroke-highlight" />
  <rect x="176" y="74" width="48" height="16" rx="6" class="stroke-highlight" />
  <rect x="176" y="96" width="48" height="16" rx="6" class="stroke-highlight" />
  <rect x="178" y="118" width="44" height="16" rx="6" class="stroke-highlight" />
  <rect x="180" y="140" width="40" height="16" rx="6" class="stroke-highlight" />
  <rect x="184" y="162" width="32" height="16" rx="6" class="stroke-highlight" />
  <path d="M200 24v160" class="stroke-highlight" opacity=".4" stroke-dasharray="2 5" />
