---
// Build process line art: three stacked planes (research, design, development) lifting off a base, with a rising
// line continuing past the stack (growth after launch). Line only, currentColor, decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Isometric-ish plane: a parallelogram centred at (cx, cy)
const plane = (cy: number) => `M70 ${cy}l90 -40l90 40l-90 40z`;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 320 320"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <!-- Base and three planes -->
  <path d={plane(250)} opacity=".2" stroke-dasharray="3 6" />
  <path d={plane(205)} opacity=".45" />
  <path d={plane(160)} opacity=".65" />
  <path d={plane(115)} opacity=".9" />
  <path d="M70 115v135M250 115v135M160 155v135" opacity=".15" />

  <!-- Research: magnifier on the bottom plane -->
  <circle cx="150" cy="203" r="9" opacity=".6" />
  <path d="M157 210l8 6" opacity=".6" />
  <!-- Design: shape + pen line on the middle plane -->
  <circle cx="140" cy="160" r="8" opacity=".75" />
  <path d="M158 168l22 -14" opacity=".75" />
  <!-- Development: brackets on the top plane -->
  <path d="M146 108l-9 7 9 7M174 108l9 7-9 7" />

  <!-- Growth line rising past the stack -->
  <path d="M232 132l26 -26 18 12 30 -44" opacity=".8" />
  <path d="M292 74h14v14" opacity=".8" />
  <circle cx="258" cy="106" r="3" opacity=".8" />
  <circle cx="276" cy="118" r="3" opacity=".8" />
</svg>
