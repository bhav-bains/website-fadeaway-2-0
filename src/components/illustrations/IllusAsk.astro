---
// Question-and-answer line art: a large speech bubble holding a question mark, answered by a smaller bubble
// with text lines. Line only, currentColor, decorative (FAQ headers).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 320 320"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <!-- Question bubble -->
  <path d="M60 40h150a28 28 0 0 1 28 28v80a28 28 0 0 1-28 28h-96l-36 30v-30h-18a28 28 0 0 1-28-28V68a28 28 0 0 1 28-28z" />
  <path d="M120 88a22 22 0 1 1 30 20c-6 3-9 8-9 14v6" stroke-width="2" />
  <circle cx="141" cy="144" r="2.5" />

  <!-- Answer bubble -->
  <path d="M150 196h112a24 24 0 0 1 24 24v44a24 24 0 0 1-24 24h-12v26l-30-26h-70a24 24 0 0 1-24-24v-44a24 24 0 0 1 24-24z" opacity=".7" />
  <path d="M152 226h96M152 244h110M152 262h70" opacity=".55" />

  <!-- Faint echo rings behind the question -->
  <circle cx="135" cy="108" r="118" opacity=".12" />
  <circle cx="135" cy="108" r="146" opacity=".07" />
</svg>
