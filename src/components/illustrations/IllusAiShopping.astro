---
// AI shopping assistant: a shopper's question, an AI answer recommending products with one store's product cited,
// plus floating cards for rising sales and structured data. Decorative, no words; colors from theme tokens.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Five-point star polygon centred on (cx, cy)
const star = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const radius = i % 2 === 0 ? r : r * 0.45;
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + radius * Math.cos(angle)).toFixed(1)},${(cy + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(' ');

const sparkle = 'M0 -9 L2.2 -2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2 -2.2 Z';

const products = [
  { x: 92, shape: 'square', tone: 'fill-accent/80', cited: true },
  { x: 214, shape: 'circle', tone: 'fill-highlight/60', cited: false },
  { x: 336, shape: 'square', tone: 'fill-white/20', cited: false },
];
const py = 222;
---

<svg class={className} viewBox="0 0 560 440" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="eco-ill-border" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-accent)" />
      <stop offset="1" style="stop-color: var(--color-highlight)" />
    </linearGradient>
    <linearGradient id="eco-ill-trend" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" style="stop-color: var(--color-highlight)" />
      <stop offset="1" style="stop-color: var(--color-accent)" />
    </linearGradient>
  </defs>

  <!-- Assistant window -->
  <rect x="60" y="24" width="440" height="340" rx="20" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
  <circle cx="88" cy="50" r="5" class="fill-white/15" />
  <circle cx="106" cy="50" r="5" class="fill-white/15" />
  <circle cx="124" cy="50" r="5" class="fill-white/15" />
  <line x1="60" y1="72" x2="500" y2="72" class="stroke-line" />

  <!-- Shopper's question -->
  <rect x="276" y="90" width="196" height="46" rx="23" class="fill-white/10" />
  <rect x="298" y="103" width="132" height="8" rx="4" class="fill-white/25" />
  <rect x="298" y="117" width="90" height="7" rx="3.5" class="fill-white/15" />

  <!-- AI answer -->
  <circle cx="100" cy="164" r="15" class="fill-accent/15" />
  <path d={sparkle} transform="translate(100 164) scale(0.8)" class="fill-accent" />
  <rect x="124" y="159" width="110" height="10" rx="5" class="fill-accent/60" />
  <rect x="92" y="188" width="330" height="8" rx="4" class="fill-white/15" />
  <rect x="92" y="202" width="270" height="8" rx="4" class="fill-white/10" />

  <!-- Recommended products; the first is the cited store -->
  {
    products.map((p) => (
      <g>
        <rect
          x={p.x}
          y={py}
          width="112"
          height="122"
          rx="12"
          class={p.cited ? 'fill-canvas' : 'fill-canvas stroke-line'}
          stroke={p.cited ? 'url(#eco-ill-border)' : undefined}
          stroke-width={p.cited ? 1.75 : 1}
        />
        <rect x={p.x + 10} y={py + 10} width="92" height="52" rx="8" class="fill-white/5" />
        {p.shape === 'circle' ? (
          <circle cx={p.x + 56} cy={py + 36} r="14" class={p.tone} />
        ) : (
          <rect x={p.x + 42} y={py + 22} width="28" height="28" rx="7" class={p.tone} />
        )}
        <rect x={p.x + 10} y={py + 74} width="64" height="7" rx="3.5" class="fill-white/25" />
        <rect x={p.x + 10} y={py + 88} width="34" height="7" rx="3.5" class={p.cited ? 'fill-highlight' : 'fill-highlight/40'} />
        {[0, 1, 2, 3, 4].map((i) => (
          <polygon points={star(p.x + 16 + i * 13, py + 107, 5)} class={p.cited ? 'fill-accent' : 'fill-white/15'} />
        ))}
      </g>
    ))
  }
  <!-- Citation badge on the store's product -->
  <circle cx="198" cy={py} r="12" class="fill-accent" />
  <path d={`M192.5 ${py}l3.5 3.5 6-7`} class="stroke-accent-ink" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Floating: sales rising -->
  <g class="motion-safe:animate-float">
    <rect x="8" y="318" width="196" height="110" rx="16" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
    <path d="M30 340h4l3 10.5h10l2.8-7.8H36" class="stroke-ink-soft" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="39" cy="355" r="1.7" class="fill-ink-soft" />
    <circle cx="46.5" cy="355" r="1.7" class="fill-ink-soft" />
    <rect x="60" y="343" width="70" height="8" rx="4" class="fill-white/25" />
    <path d="M30 408 H182" class="stroke-line" />
    <polyline points="30,400 66,390 100,394 136,368 176,350" stroke="url(#eco-ill-trend)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="176" cy="350" r="4.5" class="fill-accent" />
  </g>

  <!-- Floating: structured data -->
  <g class="motion-safe:animate-float [animation-delay:-3s]">
    <rect x="426" y="4" width="126" height="56" rx="16" class="fill-surface-raised stroke-line-strong" stroke-width="1.5" />
    <path d="M456 17c-5 0-6 3-6 7v3c0 3-2 5-5 5 3 0 5 2 5 5v3c0 4 1 7 6 7" class="stroke-highlight" stroke-width="2" stroke-linecap="round" />
    <path d="M522 17c5 0 6 3 6 7v3c0 3 2 5 5 5-3 0-5 2-5 5v3c0 4-1 7-6 7" class="stroke-highlight" stroke-width="2" stroke-linecap="round" />
    <rect x="466" y="25" width="44" height="6" rx="3" class="fill-highlight/70" />
    <rect x="466" y="35" width="30" height="6" rx="3" class="fill-white/20" />
  </g>
</svg>
