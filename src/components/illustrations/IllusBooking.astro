---
// Wellness "why us" line art: a phone showing a booking calendar with a confirmed slot, a shield with a tick
// beside it (compliance-ready), and a map pin above (found locally). Line only, currentColor, decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 320 320"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <!-- Phone -->
  <rect x="96" y="40" width="128" height="240" rx="20" />
  <path d="M140 56h40" opacity=".6" />
  <!-- Calendar grid -->
  <path d="M112 96h96" opacity=".5" />
  <g opacity=".45">
    <path d="M112 116h96M112 136h96M112 156h96M112 176h96" />
    <path d="M136 96v100M160 96v100M184 96v100" />
  </g>
  <rect x="160" y="136" width="24" height="20" rx="3" />
  <path d="M165 146l4 4 9 -9" />
  <!-- Book button -->
  <rect x="116" y="214" width="88" height="26" rx="13" />
  <!-- Shield (compliance) -->
  <path d="M252 150l-28 10v20c0 17 12 30 28 35 16 -5 28 -18 28 -35v-20z" opacity=".8" />
  <path d="M240 182l8 8 15 -16" opacity=".8" />
  <!-- Map pin (found locally) -->
  <path d="M60 120s-24 -21 -24 -40a24 24 0 0 1 48 0c0 19 -24 40 -24 40z" opacity=".7" />
  <circle cx="60" cy="80" r="8" opacity=".7" />
  <path d="M60 120c10 18 26 28 36 30" opacity=".4" stroke-dasharray="3 5" />
  <circle cx="160" cy="160" r="150" opacity=".1" />
</svg>
