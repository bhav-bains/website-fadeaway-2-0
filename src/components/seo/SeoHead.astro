---
// Everything a page needs in <head> for search and sharing (CLAUDE.md section 4).
import { siteConfig } from '../../data/site';
import { buildGraph, serializeJsonLd, webPageSchema, type JsonLdNode } from '../../lib/schema';
import { pageDates } from '../../lib/page-dates';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Absolute URL; defaults to the current path on the production domain */
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  /** Page-level JSON-LD nodes, added to the sitewide Organization + WebSite graph */
  jsonLd?: JsonLdNode[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical,
  ogImage = siteConfig.defaultOgImage,
  ogImageAlt = siteConfig.defaultOgImageAlt,
  ogType = 'website',
  noIndex = false,
  jsonLd = [],
} = Astro.props as SeoProps;

const TITLE_MAX = 60;
const DESCRIPTION_MAX = 155;
if (title.length > TITLE_MAX) {
  console.warn(`[seo] ${Astro.url.pathname}: title is ${title.length} chars (max ${TITLE_MAX})`);
}
if (description.length > DESCRIPTION_MAX) {
  console.warn(`[seo] ${Astro.url.pathname}: description is ${description.length} chars (max ${DESCRIPTION_MAX})`);
}

// Trailing slash matches the built /page/index.html files, Netlify's URLs and the sitemap
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? new URL(path, siteConfig.url).toString();
const ogImageUrl = new URL(ogImage, siteConfig.url).toString();

// Dates from git (src/lib/page-dates.ts; same source as the sitemap <lastmod>). Metadata only, never shown.
// Indexable pages: dateModified on the page's own node (WebPage, CollectionPage, AboutPage, ContactPage or
// Article); a page without one gets a WebPage node. Articles also get datePublished + article:*_time meta.
const PAGE_NODE_TYPES = ['WebPage', 'CollectionPage', 'AboutPage', 'ContactPage', 'Article'];
const dates = noIndex ? {} : pageDates(path);
const pageNode = jsonLd.find((node) => PAGE_NODE_TYPES.includes(node['@type'] as string));
const isArticle = pageNode?.['@type'] === 'Article';
const withDates = (node: JsonLdNode): JsonLdNode => ({
  ...node,
  ...(isArticle && dates.published && { datePublished: dates.published }),
  ...(dates.modified && { dateModified: dates.modified }),
});
const pageJsonLd = noIndex
  ? jsonLd
  : pageNode
    ? jsonLd.map((node) => (node === pageNode ? withDates(node) : node))
    : [withDates(webPageSchema({ url: path, name: title, description })), ...jsonLd];
const articleTimes = ogType === 'article' && !noIndex ? dates : {};

const robots = noIndex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
{/* noindex pages (404, thank-you) get no canonical: there is no URL to consolidate to */}
{!noIndex && <link rel="canonical" href={canonicalUrl} />}
<meta name="robots" content={robots} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
{articleTimes.published && <meta property="article:published_time" content={articleTimes.published} />}
{articleTimes.modified && <meta property="article:modified_time" content={articleTimes.modified} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script type="application/ld+json" set:html={serializeJsonLd(buildGraph(pageJsonLd))} />
