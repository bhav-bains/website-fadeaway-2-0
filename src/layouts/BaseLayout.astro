---
// Page shell for every route: head (SEO, fonts, analytics), header, <main>, footer.
// Pages render only their sections inside it.
import '../styles/globals.css';
import { Font } from 'astro:assets';
import SeoHead, { type SeoProps } from '../components/seo/SeoHead.astro';
import Analytics from '../components/seo/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';

interface Props extends SeoProps {
  /** Extra classes for <main>, e.g. top padding on pages without a full-bleed hero */
  mainClass?: string;
}

const { mainClass, ...seo } = Astro.props;
const { metaPixelId } = siteConfig.analytics;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--ff-outfit" preload />
    <Font cssVariable="--ff-dm-sans" preload />

    <SeoHead {...seo} />
    <Analytics />
  </head>
  <body>
    {
      metaPixelId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
            alt=""
          />
        </noscript>
      )
    }

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:rounded-control focus:bg-accent focus:px-2 focus:py-1 focus:text-accent-ink"
    >
      Skip to content
    </a>

    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
